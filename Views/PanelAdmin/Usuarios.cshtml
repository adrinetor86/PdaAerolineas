@model List<PdaAerolineas.Models.Views.VistaAdministracionUsuarios>


@{
    Layout = "_AdminLayout";
    var paginaActual   = ViewData["PAGINA_ACTUAL"]   as int? ?? 1;
    var totalPaginas   = ViewData["TOTAL_PAGINAS"]   as int? ?? 1;
    var totalRegistros = ViewData["TOTAL_REGISTROS"] as int? ?? 0;
    var registrosPag   = ViewData["REGISTROS_PAG"]   as int? ?? 10;
    var busqueda       = ViewData["BUSQUEDA"]        as string ?? string.Empty;
    var aerolineaId    = ViewData["AEROLINEA_ID"]    as int?;
    var activo         = ViewData["ACTIVO"]          as bool?;
    var aerolineas     = ViewData["AEROLINEAS"]      as List<Aerolinea> ?? new();

    var inicioRegistro = totalRegistros == 0 ? 0 : (paginaActual - 1) * registrosPag + 1;
    var finRegistro    = Math.Min(totalRegistros, paginaActual * registrosPag);

    bool hayFiltros = !string.IsNullOrEmpty(busqueda) || aerolineaId.HasValue || activo.HasValue;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Gestión de Usuarios</h1>
            <p class="mt-2 text-sm text-gray-600">Listado completo de personal y sus roles asignados.</p>
        </div>
        <div class="mt-4 md:mt-0">
            <a asp-controller="Usuarios" asp-action="Register"
               class="inline-flex items-center px-4 py-2 border border-transparent rounded-xl shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                Registrar Usuario
            </a>
        </div>
    </div>

    <form method="get" asp-action="Usuarios" id="formFiltros" class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        @Html.AntiForgeryToken()
        <input type="hidden" name="numPag" id="inputNumPag" value="@paginaActual"/>

        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50/70 px-5 py-3">
            <div class="flex flex-wrap items-center gap-2">

                <a href="@Url.Action("Usuarios", "PanelAdmin")"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 hover:border-red-400 hover:text-red-500 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                    </svg>
                    Limpiar
                </a>

                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200">
                        "@busqueda"
                        <button type="button" onclick="clearField('busqueda')" class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                    </span>
                }
                @if (aerolineaId.HasValue)
                {
                    var nombreAerolinea = aerolineas.FirstOrDefault(a => a.IdAerolinea == aerolineaId)?.Nombre ?? aerolineaId.ToString();
                    <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-bold text-indigo-700 ring-1 ring-indigo-200">
                        @nombreAerolinea
                        <button type="button" onclick="clearField('aerolineaId')" class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                    </span>
                }
                @if (activo.HasValue)
                {
                    <span class="inline-flex items-center gap-1 rounded-full @(activo.Value ? "bg-green-50 text-green-700 ring-green-200" : "bg-red-50 text-red-700 ring-red-200") px-2.5 py-0.5 text-xs font-bold ring-1">
                        @(activo.Value ? "Activos" : "Inactivos")
                        <button type="button" onclick="clearField('activo')" class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                    </span>
                }
            </div>

            <div class="flex flex-wrap items-center gap-2">

                <div class="relative">
                    <select name="aerolineaId" onchange="resetPage(); this.form.submit()"
                            class="appearance-none cursor-pointer rounded-lg border py-1.5 pl-3 pr-7 font-mono text-xs outline-none transition-all @(aerolineaId.HasValue ? "border-indigo-400 bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" : "border-gray-300 bg-white text-gray-700 hover:border-gray-400 focus:border-blue-400")">
                        <option value="">Todas las aerolíneas</option>
                        @foreach (var a in aerolineas)
                        {
                            <option value="@a.IdAerolinea" selected="@(aerolineaId == a.IdAerolinea ? "selected" : null)">@a.Nombre</option>
                        }
                    </select>
                    <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>

                <div class="relative">
                    <select name="activo" onchange="resetPage(); this.form.submit()"
                            class="appearance-none cursor-pointer rounded-lg border py-1.5 pl-3 pr-7 font-mono text-xs outline-none transition-all @(activo.HasValue ? "border-green-400 bg-green-50 text-green-700 ring-1 ring-green-200" : "border-gray-300 bg-white text-gray-700 hover:border-gray-400 focus:border-blue-400")">
                        <option value="">Todos los estados</option>
                        <option value="true" selected="@(activo == true ? "selected" : null)">Activos</option>
                        <option value="false" selected="@(activo == false ? "selected" : null)">Inactivos</option>
                    </select>
                    <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>

                <div class="relative">
                    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" name="busqueda" value="@busqueda" placeholder="Nombre, email, rol..."
                           onkeydown="if(event.key==='Enter'){ resetPage(); this.form.submit(); }"
                           class="w-56 rounded-lg border py-1.5 pl-9 pr-4 text-xs font-mono outline-none transition-all focus:w-72 @(!string.IsNullOrEmpty(busqueda) ? "border-blue-400 bg-blue-50 text-blue-700 ring-1 ring-blue-200" : "border-gray-300 bg-white text-gray-700 focus:border-blue-400 focus:ring-1 focus:ring-blue-100")"/>
                </div>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-5 py-3 font-semibold">Nombre</th>
                    <th class="px-5 py-3 font-semibold">Email</th>
                    <th class="px-5 py-3 font-semibold">Rol</th>
                    <th class="px-5 py-3 font-semibold">Aerolínea</th>
                    <th class="px-5 py-3 font-semibold">Estado</th>
                    <th class="px-5 py-3 font-semibold text-right">Acciones</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-5 py-10 text-center text-sm text-slate-400">
                            No se encontraron usuarios.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        string nombreCompleto = item.Nombre + " " + item.Apellidos;
                        <tr class="hover:bg-slate-50 transition duration-150">
                            <td class="px-5 py-3 whitespace-nowrap">
                                <div class="flex items-center gap-3">
                                    <div class="h-9 w-9 flex-shrink-0 bg-blue-100 rounded-full flex items-center justify-center text-blue-700 font-bold text-sm">
                                        @nombreCompleto.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="text-sm font-semibold text-gray-900">@nombreCompleto</span>
                                </div>
                            </td>
                            <td class="px-5 py-3 whitespace-nowrap text-sm text-gray-600">@item.Email</td>
                            <td class="px-5 py-3 whitespace-nowrap">
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                                    @item.Rol
                                </span>
                            </td>
                            <td class="px-5 py-3 whitespace-nowrap">
                                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                                    @item.Aerolinea
                                </span>
                            </td>
                            <td class="px-5 py-3 whitespace-nowrap">
                                @if (item.Activo)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="px-5 py-3 whitespace-nowrap text-right text-sm font-medium">
                                <a asp-controller="Usuarios" asp-action="Update" asp-route-idUsuario="@item.Id"
                                   class="text-blue-600 hover:text-blue-900 mr-3">Editar</a>


                                <button type="button" onclick="eliminarUsuario(@item.Id, '@item.Nombre @item.Apellidos')"
                                        class="text-red-600 hover:text-red-900">Eliminar</button>
                                
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 bg-slate-50/70 px-5 py-3">
            <p class="font-mono text-xs text-gray-500">
                Mostrando <strong class="text-gray-800">@inicioRegistro</strong>
                a <strong class="text-gray-800">@finRegistro</strong>
                de <strong class="text-gray-800">@totalRegistros</strong> usuarios
            </p>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1">
                    <button type="button" onclick="cambiarPagina(1)" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">«</button>
                    <button type="button" onclick="cambiarPagina(@(paginaActual - 1))" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">‹</button>

                    @{
                        var rng = 2;
                        var start = Math.Max(1, paginaActual - rng);
                        var end = Math.Min(totalPaginas, paginaActual + rng);
                    }
                    @if (start > 1)
                    {
                        <button type="button" onclick="cambiarPagina(1)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">1</button>
                        if (start > 2)
                        {
                            <span class="px-1 font-mono text-xs text-gray-400">…</span>
                        }
                    }
                    @for (var p = start; p <= end; p++)
                    {
                        if (p == paginaActual)
                        {
                            <button type="button" onclick="cambiarPagina(@p)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-900 bg-gray-900 font-mono text-xs font-bold text-white">@p</button>
                        }
                        else
                        {
                            <button type="button" onclick="cambiarPagina(@p)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@p</button>
                        }
                    }
                    @if (end < totalPaginas)
                    {
                        if (end < totalPaginas - 1)
                        {
                            <span class="px-1 font-mono text-xs text-gray-400">…</span>
                        }

                        <button type="button" onclick="cambiarPagina(@totalPaginas)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@totalPaginas</button>
                    }

                    <button type="button" onclick="cambiarPagina(@(paginaActual + 1))" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">›</button>
                    <button type="button" onclick="cambiarPagina(@totalPaginas)" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">»</button>
                </div>

                <div class="relative">
                    <select name="numFilas" onchange="resetPage(); this.form.submit()"
                            class="appearance-none cursor-pointer rounded-lg border border-gray-300 bg-white py-1.5 pl-3 pr-7 font-mono text-xs text-gray-700 outline-none transition-all hover:border-gray-400 focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                        <option value="5" selected="@(registrosPag == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(registrosPag == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(registrosPag == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(registrosPag == 50 ? "selected" : null)">50</option>
                    </select>
                    <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function cambiarPagina(num) {
        if (num < 1) return;
        document.getElementById('inputNumPag').value = num;
        document.getElementById('formFiltros').submit();
    }
    function resetPage() { document.getElementById('inputNumPag').value = 1; }
    function clearField(name) {
        const f = document.getElementById('formFiltros');
        const el = f.querySelector(`[name="${name}"]`);
        if (el) el.value = '';
        resetPage();
        f.submit();
    }

    async function eliminarUsuario(id, nombre) {
        const s = await Swal.fire({
            title: `¿Eliminar a ${nombre}?`,
            text: 'Esta acción no se puede deshacer.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        });
        if (!s.isConfirmed) return;

        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Usuarios/Delete';
        form.innerHTML = `
        <input type="hidden" name="idUsuario" value="${id}">
        <input type="hidden" name="__RequestVerificationToken" 
               value="${document.querySelector('input[name=__RequestVerificationToken]').value}">
    `;
        document.body.appendChild(form);
        form.submit();
    }
    
</script>
}
