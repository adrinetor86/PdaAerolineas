@model PdaAerolineas.Models.Aerolinea
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Aerolínea";
}

<div class="max-w-2xl mx-auto px-6 py-8">
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-gray-900">Editar Aerolínea: @Model.Nombre</h1>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
        <form asp-action="Update" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <input type="hidden" asp-for="IdAerolinea"  />
            <input type="hidden" asp-for="Logo" />

            <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

            <div class="mb-4">
                <label asp-for="Nombre" class="block text-sm font-semibold text-gray-700 mb-2"></label>
                <input asp-for="Nombre" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="Nombre" class="text-red-600 text-sm"></span>
            </div>

            <div class="mb-4">
                <label asp-for="CodIata" class="block text-sm font-semibold text-gray-700 mb-2">Código IATA</label>
                <input asp-for="CodIata" maxlength="3" style="text-transform: uppercase;" 
                       value="@Model.CodIata"
                       class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500" />
                <span asp-validation-for="CodIata" class="text-red-600 text-sm"></span>
            </div>
            
            
            <div class="mb-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Logo de la Aerolínea</label>
                <div class="flex items-center gap-4">
                    <div class="h-16 w-16 border rounded flex items-center justify-center bg-gray-50">
                        @if (!string.IsNullOrEmpty(Model.Logo)) {
                            <img id="current-logo" src="~/images/logos/@Model.Logo" class="max-h-full max-w-full object-contain" />
                        } else {
                            <span class="text-gray-400 text-xs">Sin logo</span>
                        }
                    </div>

                    <label class="flex items-center gap-2 px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-200 transition">
                        <span>Seleccionar logo</span>

                        <input name="logo"
                               type="file"
                               accept="image/*"
                               class="hidden"
                               onchange="previewImage(this)"/>
                    </label>

                    <div id="preview-container" class="hidden">
                        <img id="preview-image" src="" alt="Preview" class="h-16 w-16 object-contain border border-gray-200 rounded"/>
                    </div>
                </div>
                <span asp-validation-for="Logo" class="text-red-600 text-sm mt-1 block"></span>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700">
                    Guardar Cambios
                </button>
                <a asp-controller="PanelAdmin" asp-action="Aerolineas" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    document.getElementById('current-logo').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}