@model VistaMantenimientos

@{
    bool esProgramado = Model.Estado == "Programado";
    bool esEnCurso    = Model.Estado == "En Curso";
    bool esFinalizado = Model.Estado == "Completado" || Model.Estado == "Cancelado";

    string badgeClass = Model.Estado switch {
        "Programado" => "bg-blue-50 text-blue-700 ring-1 ring-blue-200",
        "En Curso"   => "bg-orange-50 text-orange-700 ring-1 ring-orange-200",
        "Completado" => "bg-green-50 text-green-700 ring-1 ring-green-200",
        "Cancelado"  => "bg-red-50 text-red-700 ring-1 ring-red-200",
        _            => "bg-gray-100 text-gray-600"
    };
}

<div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden my-10">

    <div class="px-8 py-6 border-b border-slate-100 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-black text-slate-900">
                Hoja Técnica #@Model.Id
            </h2>
            <p class="text-[11px] uppercase tracking-widest text-blue-600 font-bold mt-0.5">
                @Model.Tipo
            </p>
        </div>
        <div class="text-right flex flex-col items-end gap-1.5">
            <p class="text-[10px] text-slate-400 font-bold uppercase">Estado</p>
            <span class="inline-block px-2.5 py-0.5 rounded-md text-xs font-bold @badgeClass">
                @Model.Estado
            </span>
        </div>
    </div>

    <div class="px-8 pt-8 pb-0 grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
            <label class="text-[10px] font-black text-slate-400 uppercase ml-1">Matrícula</label>
            <input type="text" value="@Model.Matricula" readonly
                   class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3 text-sm font-bold text-slate-600" />
        </div>

        <div>
            <label class="text-[10px] font-black text-slate-400 uppercase ml-1">Modelo</label>
            <input type="text" value="@Model.Modelo" readonly
                   class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3 text-sm font-bold text-slate-600" />
        </div>

        <div>
            <label class="text-[10px] font-black text-slate-400 uppercase ml-1">Tipo de Mantenimiento</label>
            <input type="text" value="@Model.Tipo" readonly
                   class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3 text-sm font-bold text-slate-600" />
        </div>

        <div>
            <label class="text-[10px] font-black text-slate-400 uppercase ml-1">Fecha Programada</label>
            <input type="text" value="@Model.FechaProgramada.ToString("dd/MM/yyyy")" readonly
                   class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3 text-sm font-bold text-slate-600" />
        </div>
    </div>


    @if (esProgramado)
    {
        <div id="bloqueIniciar" class="px-8 py-8 space-y-5">

            <div class="flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 px-5 py-4">
                <svg class="text-blue-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <p class="text-xs text-blue-700 font-semibold leading-relaxed">
                    La inspección aún no ha comenzado. Pulsa <strong>"Iniciar Inspección"</strong> para registrar
                    la hora de inicio y desbloquear el formulario de seguimiento.
                </p>
            </div>

            <div id="errorIniciar"
                 class="hidden flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-5 py-4">
                <svg class="text-red-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/>
                    <line x1="9" y1="9" x2="15" y2="15"/>
                </svg>
                <p id="errorIniciarTexto" class="text-xs text-red-700 font-semibold"></p>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-slate-100">
                <a asp-action="Index"
                   class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-slate-600 transition-colors">
                    ← Volver
                </a>
                <button type="button" id="btnIniciar" onclick="iniciarInspeccion(@Model.Id)"
                        class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 active:bg-orange-700
                               text-white px-8 py-3 rounded-xl text-xs font-black shadow-lg transition-all uppercase tracking-widest">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5">
                        <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                    <span id="btnIniciarLabel">Iniciar Inspección</span>
                </button>
            </div>
        </div>


        <div id="bloqueDescripcion" class="hidden px-8 pb-8">
            @await Html.PartialAsync("_FormDescripcion", Model)
        </div>
    }

    @if (esEnCurso)
    {
        <div class="px-8 pb-8">

            <div class="flex items-center gap-3 rounded-xl border border-orange-100 bg-orange-50 px-5 py-3.5 mt-6 mb-6">
                <span class="flex h-2 w-2 rounded-full bg-orange-400 animate-pulse"></span>
                <p class="text-xs text-orange-700 font-semibold">
                    Inspección en curso · Registra aquí las observaciones y hallazgos técnicos.
                </p>
            </div>

            @await Html.PartialAsync("_FormDescripcion", Model)
        </div>
    }


    @if (esFinalizado)
    {
        <div class="px-8 py-8 space-y-5">

            <div class="@(Model.Estado == "Cancelado" ? "border-red-100 bg-red-50" : "border-green-100 bg-green-50")
                        flex items-start gap-3 rounded-xl border px-5 py-4">
                <svg class="@(Model.Estado == "Cancelado" ? "text-red-400" : "text-green-500") shrink-0 mt-0.5"
                     xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5">
                    @if (Model.Estado == "Cancelado")
                    {
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/>
                        <line x1="9" y1="9" x2="15" y2="15"/>
                    }
                    else
                    {
                        <polyline points="20 6 9 17 4 12"/>
                    }
                </svg>
                <p class="text-xs font-semibold @(Model.Estado == "Cancelado" ? "text-red-700" : "text-green-700")">
                    Este mantenimiento está <strong>@Model.Estado.ToLower()</strong> y no puede modificarse.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase ml-1 mb-2">Descripción registrada</p>
                    <div class="w-full bg-slate-50 border-2 border-slate-100 rounded-xl px-4 py-3 text-sm text-slate-700 whitespace-pre-wrap">
                        @Model.Descripcion
                    </div>
                </div>
            }

            <div class="pt-4 border-t border-slate-100">
                <a asp-action="Index"
                   class="px-6 py-3 text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-slate-600 transition-colors">
                    ← Volver al listado
                </a>
            </div>
        </div>
    }

</div>
@section Scripts {
<script>
    async function iniciarInspeccion(idMantenimiento) {
        const btn   = document.getElementById('btnIniciar');
        const label = document.getElementById('btnIniciarLabel');
        const error = document.getElementById('errorIniciar');
        const errorTxt = document.getElementById('errorIniciarTexto');

        // Estado de carga
        btn.disabled    = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');
        label.textContent = 'Iniciando...';
        error.classList.add('hidden');

        try {

            const res = await fetch(`/Mantenimientos/IniciarMantenimiento?idMantenimiento=${idMantenimiento}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
            });
            
            const data = await res.json();

            if (data.ok) {
                // Éxito: ocultar bloque iniciar y mostrar formulario descripción
                document.getElementById('bloqueIniciar').classList.add('hidden');
                document.getElementById('bloqueDescripcion').classList.remove('hidden');

                // Actualizar badge de estado en el header
                const badge = document.querySelector('[class*="ring-blue-200"]');
                if (badge) {
                    badge.textContent = 'En Curso';
                    badge.className = badge.className
                        .replace(/bg-blue-50/g, 'bg-orange-50')
                        .replace(/text-blue-700/g, 'text-orange-700')
                        .replace(/ring-blue-200/g, 'ring-orange-200');
                }
            } else {
                // Error del servidor: mostrar mensaje
                errorTxt.textContent = data.mensaje;
                error.classList.remove('hidden');

                // Restaurar botón
                btn.disabled = false;
                btn.classList.remove('opacity-60', 'cursor-not-allowed');
                label.textContent = 'Iniciar Inspección';
            }

        } catch (e) {
            errorTxt.textContent = 'Error de comunicación con el servidor. Inténtalo de nuevo.';
            error.classList.remove('hidden');
            btn.disabled = false;
            btn.classList.remove('opacity-60', 'cursor-not-allowed');
            label.textContent = 'Iniciar Inspección';
        }
    }
</script>
}
