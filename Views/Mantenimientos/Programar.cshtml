@{
    List<VistaAvion> aviones = ViewData["AVIONES"] as List<VistaAvion> ?? new List<VistaAvion>();
    List<MantenimientoTipo> tiposMantenimiento = ViewData["TIPOSMANTENIMIENTO"] as List<MantenimientoTipo> ?? new List<MantenimientoTipo>();
}

<div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mt-8">
    
    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/50 flex items-center gap-3">
        <div class="p-2 bg-blue-100 text-blue-600 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
        </div>
        <div>
            <h2 class="text-lg font-bold text-slate-800">Programar Mantenimiento</h2>
            <p class="text-xs font-medium text-slate-500 mt-0.5">Asigne una aeronave a una revisión técnica programada.</p>
        </div>
    </div>

    <form method="post" class="p-8 space-y-6">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                    Aeronave a intervenir <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <select name="avion" required
                            class="appearance-none w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none transition-all cursor-pointer hover:border-blue-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                        <option value="" disabled selected>Seleccione matrícula...</option>
                        @foreach (VistaAvion avion in aviones)
                        {
                            <option value="@avion.Id">@avion.Matricula - @avion.Modelo</option>
                        }
                    </select>
                    <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                    Tipo de Mantenimiento <span class="text-red-500">*</span>
                </label>
                <div class="relative">
                    <select name="tipoMantenimiento" required
                            class="appearance-none w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none transition-all cursor-pointer hover:border-blue-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10">
                        <option value="" disabled selected>Seleccione tipo...</option>
                        @foreach (MantenimientoTipo mantenimiento in tiposMantenimiento)
                        {
                            <option value="@mantenimiento.Id">@mantenimiento.Nombre</option>
                        }
                    </select>
                    <svg class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6-6"/></svg>
                </div>
            </div>

            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                    Fecha Programada <span class="text-red-500">*</span>
                </label>
                <input type="date" name="fechaProgramada" required
                       class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm font-bold rounded-xl px-4 py-3 outline-none transition-all cursor-pointer hover:border-blue-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
            </div>
            
        </div>

        <div class="pt-2">
            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">
                Descripción / Notas Operativas
            </label>
            <textarea name="descripcion" rows="3" placeholder="Detalles de la revisión, fallos reportados por tripulación..."
                      class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-4 py-3 outline-none transition-all hover:border-blue-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 resize-none"></textarea>
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-end gap-3">
            <a asp-controller="Mantenimientos" asp-action="Index" class="px-5 py-2.5 rounded-xl text-sm font-bold text-slate-500 hover:bg-slate-100 transition-colors">
                Cancelar
            </a>
            <button  class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 hover:-translate-y-0.5 transition-all">
                Guardar Orden
            </button>
        </div>
        
    </form>
</div>