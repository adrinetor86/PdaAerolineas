@using PdaAerolineas.Models.Views
@model List<VistaRutaAerolinea>

@{
    var rutasMapa = ViewData["RUTAS_MAPA"] as List<VistaRuta> ?? new List<VistaRuta>();
    var rutasDisponibles = ViewData["RUTAS_DISPONIBLES"] as List<VistaRuta> ?? new List<VistaRuta>();

    var busqueda = ViewData["BUSQUEDA"] as string ?? "";


}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">


    <div class="flex items-end justify-between">
        <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">Gestión de Rutas</h2>
        </div>
        <button id="btnAsignarRuta"
                class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="3">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Asignar Nueva Ruta
        </button>
    </div>


    <div class="rounded-xl border border-gray-200 shadow-sm overflow-hidden relative" style="z-index: 1;">
        <div id="map" style="height: 600px; width: 100%"></div>
    </div>


    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                <div class="px-5 py-4 border-b border-gray-100 bg-gray-50/40">
                    <div class="flex items-center gap-4">
                        <div class="flex-1 relative">
                            <input type="text" id="inputBusquedaAjax" placeholder="Buscar por codigo, ciudad, aeropuerto..."
                                   class="w-full pl-10 pr-4 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none transition"
                                   oninput="buscarRutasAjax()" value="@busqueda"/>
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <span id="infoPaginacion" class="text-xs font-mono text-gray-400"></span>
              
                    </div>
                </div>

                <div id="tablaAjaxContainer">
                    <partial name="_RutasTablaPartial" model="Model" />
                </div>
            </div>

    </div>

</div>


<div id="modalAsignar" class="fixed inset-0 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
     style="z-index: 60;">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl p-8 relative m-4">
        <div class="flex justify-between items-center mb-6 border-b border-gray-100 pb-4">
            <h2 class="text-xl font-bold text-gray-800">Asignar Nueva Ruta</h2>
            <button onclick="cerrarModalAsignar()"
                    class="text-gray-400 hover:text-gray-700 text-2xl bg-gray-100 hover:bg-gray-200 rounded-full w-8 h-8 flex items-center justify-center">
                &times;
            </button>
        </div>
        <div id="panelErrorAsignar" class="hidden rounded-xl border-2 border-red-200 bg-red-50 px-5 py-3 mb-4">
            <p id="msgErrorAsignar" class="text-sm text-red-700 font-bold"></p>
        </div>
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ruta *</label>
                <select id="selectRutaAsignar"
                        class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition">
                    <option value="" disabled selected>Seleccionar ruta...</option>
                    @foreach (var r in rutasDisponibles)
                    {
                        <option
                            value="@r.Id">@r.CodOrigen → @r.CodDestino (@r.CiudadOrigen → @r.CiudadDestino · @r.Distancia km)
                        </option>
                    }
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Precio Base
                        (€)</label>
                    <input type="number" id="inputPrecioAsignar" step="0.01" min="0" placeholder="Ej: 120.50"
                           class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition"/>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Frecuencia
                        Semanal</label>
                    <input type="number" id="inputFrecuenciaAsignar" min="0" placeholder="Ej: 7"
                           class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition"/>
                </div>
            </div>
        </div>
        <div class="flex justify-end space-x-3 pt-6 border-t border-gray-100 mt-6">
            <button onclick="cerrarModalAsignar()"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold text-gray-600 hover:bg-gray-100 transition">Cancelar
            </button>
            <button onclick="confirmarAsignar()"
                    class="px-8 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all">
                Asignar Ruta
            </button>
        </div>
    </div>
</div>


<div id="modalEditar" class="fixed inset-0 hidden items-center justify-center bg-black/40 backdrop-blur-sm"
     style="z-index: 60;">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl p-8 relative m-4">
        <div class="flex justify-between items-center mb-6 border-b border-gray-100 pb-4">
            <h2 class="text-xl font-bold text-gray-800">Editar Ruta <span id="lblRutaEditar"
                                                                          class="text-blue-600"></span></h2>
            <button onclick="cerrarModalEditar()"
                    class="text-gray-400 hover:text-gray-700 text-2xl bg-gray-100 hover:bg-gray-200 rounded-full w-8 h-8 flex items-center justify-center">
                &times;
            </button>
        </div>
        <input type="hidden" id="inputIdRutaEditar"/>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Precio Base
                    (€)</label>
                <input type="number" id="inputPrecioEditar" step="0.01" min="0"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition"/>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Frecuencia
                    Semanal</label>
                <input type="number" id="inputFrecuenciaEditar" min="0"
                       class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition"/>
            </div>
        </div>
        <div class="flex justify-end space-x-3 pt-6 border-t border-gray-100 mt-6">
            <button onclick="cerrarModalEditar()"
                    class="px-6 py-2.5 rounded-xl text-sm font-bold text-gray-600 hover:bg-gray-100 transition">Cancelar
            </button>
            <button onclick="confirmarEditar()"
                    class="px-8 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all">
                Guardar Cambios
            </button>
        </div>
    </div></div>
@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.fullscreen/3.0.2/Control.FullScreen.min.js"></script>

    <script>
        let paginaGlobal = 1;

        // ✅ Función base que hace el fetch
        async function cargarTablaRutas(pagina, busqueda, filas) {
            const contenedor = document.getElementById('tablaAjaxContainer');
            contenedor.style.opacity = '0.5';

            // ❌ Tenías una línea suelta: @Url.Action("Index") — ELIMINADA
            const url = `@Url.Action("Index")?numPag=${pagina}&numFilas=${filas}&busqueda=${encodeURIComponent(busqueda)}`;

            try {
                const response = await fetch(url, {
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                if (response.ok) {
                    contenedor.innerHTML = await response.text();
                    paginaGlobal = pagina;
                }
            } catch (e) {
                console.error("Error en AJAX:", e);
            } finally {
                contenedor.style.opacity = '1';
            }
        }


        function cambiarPaginaAjax(pagina) {
            if (pagina < 1) return;
            const busqueda = document.getElementById('inputBusquedaAjax').value;
   
            const filas = document.getElementById('selectFilasPartial')?.value ?? '10';
            cargarTablaRutas(pagina, busqueda, filas);
        }

        let debounceTimer;
        function buscarRutasAjax() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => cambiarPaginaAjax(1), 300);
        }

        // ── MAPA ──
        const rutasMapa = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rutasMapa));
        const map = L.map('map',{
            fullscreenControl: true,        
            fullscreenControlOptions: {
                position: 'topright',           // topleft | topright | bottomleft | bottomright
                title: 'Ver en pantalla completa',
                titleCancel: 'Salir de pantalla completa'
        }
        }).setView([40.4, -3.7], 5);
        
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            attribution: '&copy; CartoDB &copy; OSM'
        }).addTo(map);

        function crearIconoAeropuerto(codigo, resaltado) {
            const labelBg = resaltado ? 'rgba(220,38,38,0.95)' : 'rgba(30,64,175,0.9)';
            const scale   = resaltado ? 'transform:scale(1.2);' : '';
            return L.divIcon({
                className: '',
                html: `<div style="display:flex;flex-direction:column;align-items:center;${scale}transition:transform .25s ease;">
                   <div style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;">
                     <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                       <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="#EF4444"/>
                     </svg>
                   </div>
                   <div style="margin-top:1px;background:${labelBg};color:white;font-size:8px;font-weight:800;padding:1px 5px;border-radius:3px;letter-spacing:.5px;white-space:nowrap;">${codigo}</div>
                </div>`,
                iconSize: [36, 44],
                iconAnchor: [18, 28],
                popupAnchor: [0, -28]
            });
        }

        const polylines = [];
        const aeropuertoMarkers = {};
        let highlightedCodigo = null;
        const aeropuertosVistos = new Set();

        rutasMapa.forEach(ruta => {
            const origen  = [parseFloat(ruta.LatitudOrigen),  parseFloat(ruta.LongitudOrigen)];
            const destino = [parseFloat(ruta.LatitudDestino), parseFloat(ruta.LongitudDestino)];

            const line = L.polyline([origen, destino], { color: '#94a3b8', weight: 1.5, opacity: 0.4 }).addTo(map);
            line.bindTooltip(`<div style="font-size:11px;"><b>${ruta.CodOrigen}</b> → <b>${ruta.CodDestino}</b><br>
                <span style="color:#6b7280;font-size:10px;">${ruta.CiudadOrigen} → ${ruta.CiudadDestino} · ${ruta.Distancia} km</span></div>`, { sticky: true });
            polylines.push({ line, codOrigen: ruta.CodOrigen, codDestino: ruta.CodDestino });

            [[ruta.CodOrigen, origen, ruta.NombreOrigen, ruta.CiudadOrigen],
             [ruta.CodDestino, destino, ruta.NombreDestino, ruta.CiudadDestino]].forEach(([cod, coords, nombre, ciudad]) => {
                if (aeropuertosVistos.has(cod)) return;
                aeropuertosVistos.add(cod);
                const m = L.marker(coords, { icon: crearIconoAeropuerto(cod, false) }).addTo(map)
                    .bindPopup(`<div style="font-size:12px;"><b style="color:#1e40af;">${cod}</b> — ${nombre}<br><span style="color:#6b7280;">${ciudad}</span></div>`);
                aeropuertoMarkers[cod] = { marker: m, coords };
            });
        });

        function resaltarAeropuerto(codigo) {
            if (highlightedCodigo === codigo) return;
            highlightedCodigo = codigo;
            Object.keys(aeropuertoMarkers).forEach(cod =>
                aeropuertoMarkers[cod].marker.setIcon(crearIconoAeropuerto(cod, cod === codigo)));
            polylines.forEach(p => {
                const conectada = p.codOrigen === codigo || p.codDestino === codigo;
                p.line.setStyle(conectada
                    ? { color: '#3b82f6', weight: 3.5, opacity: 0.9 }
                    : { color: '#e2e8f0', weight: 1,   opacity: 0.25 });
                if (conectada) p.line.bringToFront();
            });
        }

        function resetearResaltado() {
            if (!highlightedCodigo) return;
            highlightedCodigo = null;
            Object.keys(aeropuertoMarkers).forEach(cod =>
                aeropuertoMarkers[cod].marker.setIcon(crearIconoAeropuerto(cod, false)));
            polylines.forEach(p => p.line.setStyle({ color: '#94a3b8', weight: 1.5, opacity: 0.4 }));
        }

        Object.keys(aeropuertoMarkers).forEach(cod => {
            aeropuertoMarkers[cod].marker.on('mouseover', () => resaltarAeropuerto(cod));
            aeropuertoMarkers[cod].marker.on('mouseout',  () => resetearResaltado());
        });

        if (rutasMapa.length > 0) {
            map.fitBounds(rutasMapa.flatMap(r => [
                [parseFloat(r.LatitudOrigen),  parseFloat(r.LongitudOrigen)],
                [parseFloat(r.LatitudDestino), parseFloat(r.LongitudDestino)]
            ]), { padding: [40, 40] });
        }

        // ── MODALES ──
        document.getElementById('btnAsignarRuta').addEventListener('click', () => {
            document.getElementById('panelErrorAsignar').classList.add('hidden');
            document.getElementById('modalAsignar').classList.replace('hidden', 'flex');
        });

        function cerrarModalAsignar() { document.getElementById('modalAsignar').classList.replace('flex', 'hidden'); }
        function cerrarModalEditar()  { document.getElementById('modalEditar').classList.replace('flex', 'hidden'); }

        function abrirEditar(idRuta, codigo, precio, freq) {
            document.getElementById('inputIdRutaEditar').value = idRuta;
            document.getElementById('lblRutaEditar').textContent = codigo;
            document.getElementById('inputPrecioEditar').value = precio !== null ? precio : '';
            document.getElementById('inputFrecuenciaEditar').value = freq !== null ? freq : '';
            document.getElementById('modalEditar').classList.replace('hidden', 'flex');
        }

        async function confirmarAsignar() {
            const ruta = document.getElementById('selectRutaAsignar').value;
            if (!ruta) {
                document.getElementById('msgErrorAsignar').textContent = 'Debe seleccionar una ruta.';
                document.getElementById('panelErrorAsignar').classList.remove('hidden');
                return;
            }
            const params = new URLSearchParams({ idRuta: ruta });
            const precio = document.getElementById('inputPrecioAsignar').value;
            const freq   = document.getElementById('inputFrecuenciaAsignar').value;
            if (precio) params.append('precioBase', precio);
            if (freq)   params.append('frecuenciaSemanal', freq);
            try {
                const result = await (await fetch('/Rutas/Asignar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: params
                })).json();
                if (result.success) {
                    cerrarModalAsignar();
                    await Swal.fire({ icon: 'success', title: '¡Ruta asignada!', text: result.message, confirmButtonColor: '#2563eb', timer: 2000, timerProgressBar: true });
                    window.location.reload();
                } else {
                    document.getElementById('msgErrorAsignar').textContent = result.message || 'Error';
                    document.getElementById('panelErrorAsignar').classList.remove('hidden');
                }
            } catch { Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo conectar.', confirmButtonColor: '#dc2626' }); }
        }

        async function confirmarEditar() {
            const params = new URLSearchParams({ idRuta: document.getElementById('inputIdRutaEditar').value });
            const p = document.getElementById('inputPrecioEditar').value;
            const f = document.getElementById('inputFrecuenciaEditar').value;
            if (p) params.append('precioBase', p);
            if (f) params.append('frecuenciaSemanal', f);
            try {
                const result = await (await fetch('/Rutas/Actualizar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: params
                })).json();
                if (result.success) {
                    cerrarModalEditar();
                    await Swal.fire({ icon: 'success', title: '¡Actualizado!', text: result.message, confirmButtonColor: '#2563eb', timer: 2000, timerProgressBar: true });
                    window.location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#dc2626' });
                }
            } catch { Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudo conectar.', confirmButtonColor: '#dc2626' }); }
        }

        async function desactivarRuta(idRuta, codigo) {
            const s = await Swal.fire({ title: `¿Desactivar ruta ${codigo}?`, text: 'No se podrán crear nuevos vuelos con esta ruta.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc2626', cancelButtonColor: '#6b7280', confirmButtonText: 'Sí, desactivar', cancelButtonText: 'Cancelar' });
            if (!s.isConfirmed) return;
            try {
                const result = await (await fetch('/Rutas/Desactivar', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ idRuta }) })).json();
                if (result.success) {
                    await Swal.fire({ icon: 'success', title: 'Desactivada', text: result.message, confirmButtonColor: '#2563eb', timer: 2000, timerProgressBar: true });
                    window.location.reload();
                } else { Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#dc2626' }); }
            } catch { Swal.fire({ icon: 'error', title: 'Error', confirmButtonColor: '#dc2626' }); }
        }

        async function reactivarRuta(idRuta, codigo) {
            const s = await Swal.fire({ title: `¿Reactivar ruta ${codigo}?`, text: 'La ruta volverá a estar disponible.', icon: 'question', showCancelButton: true, confirmButtonColor: '#16a34a', cancelButtonColor: '#6b7280', confirmButtonText: 'Sí, reactivar', cancelButtonText: 'Cancelar' });
            if (!s.isConfirmed) return;
            try {
                const result = await (await fetch('/Rutas/Reactivar', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ idRuta }) })).json();
                if (result.success) {
                    await Swal.fire({ icon: 'success', title: '¡Reactivada!', text: result.message, confirmButtonColor: '#2563eb', timer: 2000, timerProgressBar: true });
                    window.location.reload();
                } else { Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#dc2626' }); }
            } catch { Swal.fire({ icon: 'error', title: 'Error', confirmButtonColor: '#dc2626' }); }
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { cerrarModalAsignar(); cerrarModalEditar(); }
        });
    </script>
}

