@using System.Runtime.InteropServices.JavaScript
@model List<VistaRuta>

@{
    
    ViewData["Title"] = "Mapa 3D";
}





<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div id="map" style="height: 420px; width: 100%;"
     class="rounded-xl border border-gray-200 shadow-sm overflow-hidden">
</div>

@* @foreach (VistaRuta ruta in Model) *@
@* { *@
@*     <p> @ruta.CiudadOrigen -> @ruta.CiudadDestino</p> *@
@* } *@

@section Scripts {
<script>
// ✅ Datos de rutas serializados desde el servidor
const rutas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

// Inicializar mapa centrado en España
const map = L.map('map').setView([40.4, -3.7], 5);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap'
}).addTo(map);

// Iconos personalizados
const iconoAeropuerto = L.divIcon({
    className: '',
    html: `<div style="
        background:#2563eb;color:white;border-radius:50%;
        width:28px;height:28px;display:flex;align-items:center;
        justify-content:center;font-size:13px;font-weight:700;
        border:2px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3)">
        ✈</div>`,
    iconSize: [28, 28],
    iconAnchor: [14, 14]
});

// Evitar marcadores duplicados (mismo aeropuerto en varias rutas)
const aeropuertosVistos = new Set();

rutas.forEach(ruta => {
    const origen  = [parseFloat(ruta.LatitudOrigen),  parseFloat(ruta.LongitudOrigen)];
    const destino = [parseFloat(ruta.LatitudDestino), parseFloat(ruta.LongitudDestino)];

    // Línea de la ruta
    const linea = L.polyline([origen, destino], {
        color: '#3b82f6',
        weight: 2,
        opacity: 0.6,
        dashArray: '6 4'
    }).addTo(map);

    linea.bindTooltip(`
        ${ruta.CiudadOrigen} (${ruta.CodOrigen}) → ${ruta.CiudadDestino} (${ruta.CodDestino})<br>
        ${ruta.Distancia} km · ${ruta.DuracionFomateada}
    `, { sticky: true });

    // Marcador origen
    if (!aeropuertosVistos.has(ruta.CodOrigen)) {
        aeropuertosVistos.add(ruta.CodOrigen);
        L.marker(origen, { icon: iconoAeropuerto })
            .addTo(map)
            .bindPopup(`
                <b>${ruta.CodOrigen}</b> — ${ruta.NombreOrigen}<br>
                <span class="text-gray-500">${ruta.CiudadOrigen}</span>
            `);
    }

    // Marcador destino
    if (!aeropuertosVistos.has(ruta.CodDestino)) {
        aeropuertosVistos.add(ruta.CodDestino);
        L.marker(destino, { icon: iconoAeropuerto })
            .addTo(map)
            .bindPopup(`
                <b>${ruta.CodDestino}</b> — ${ruta.NombreDestino}<br>
                <span class="text-gray-500">${ruta.CiudadDestino}</span>
            `);
    }
});

// Ajustar zoom para que entren todos los puntos
if (rutas.length > 0) {
    const puntos = rutas.flatMap(r => [
        [parseFloat(r.LatitudOrigen),  parseFloat(r.LongitudOrigen)],
        [parseFloat(r.LatitudDestino), parseFloat(r.LongitudDestino)]
    ]);
    map.fitBounds(puntos, { padding: [40, 40] });
}
</script>
}