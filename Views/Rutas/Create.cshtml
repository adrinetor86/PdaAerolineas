@model List<Aeropuerto>
@{
    Layout = "_AdminLayout";
    var errores = ViewData["ERRORES"] as List<PdaAerolineas.Models.FormViews.FormError> ?? new();
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <h1 class="text-3xl font-black text-slate-900">Crear ruta</h1>
        <p class="text-sm text-slate-500">Define origen, destino y distancia en kilómetros. Se creará la ruta de ida y la inversa si no existe.</p>
    </div>


    @if (errores.Any())
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            <ul class="list-disc list-inside space-y-1">
                @foreach (var e in errores)
                {
                    <li>@e.Message</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <label class="text-[11px] font-black uppercase tracking-wide text-slate-500">Aeropuerto origen</label>
                <div class="relative mt-1">
                    <select id="selectOrigen" name="aeropuertoOrigen" class="w-full appearance-none rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:border-blue-400 focus:ring-2 focus:ring-blue-200">
                        <option value="">Seleccione origen</option>
                        @foreach (var a in Model)
                        {
                            <option value="@a.IdAeropuerto">@a.Cod_Iata - @a.Nombre (@a.Ciudad)</option>
                        }
                    </select>
                    <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </div>
            </div>
            <div>
                <label class="text-[11px] font-black uppercase tracking-wide text-slate-500">Aeropuerto destino</label>
                <div class="relative mt-1">
                    <select id="selectDestino" name="aeroPuertoDestino" class="w-full appearance-none rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:border-blue-400 focus:ring-2 focus:ring-blue-200">
                        <option value="">Seleccione destino</option>
                        @foreach (var a in Model)
                        {
                            <option value="@a.IdAeropuerto">@a.Cod_Iata - @a.Nombre (@a.Ciudad)</option>
                        }
                    </select>
                    <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="max-w-xs">
            <label class="text-[11px] font-black uppercase tracking-wide text-slate-500">Distancia (km)</label>
            <input type="number" name="distancia" min="1" step="1" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-800 shadow-sm focus:border-blue-400 focus:ring-2 focus:ring-blue-200" placeholder="Ej. 550" />
        </div>

        <div class="flex items-center justify-between pt-2">
            <a asp-action="Rutas" asp-controller="PanelAdmin" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-slate-700">
                ← Volver
            </a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-200">
                Crear ruta
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const selectOrigen = document.getElementById('selectOrigen');
    const selectDestino = document.getElementById('selectDestino');

    function syncOptions() {
        const oVal = selectOrigen.value;
        const dVal = selectDestino.value;

        [...selectDestino.options].forEach(opt => {
            if (!opt.value) return;
            opt.disabled = opt.value === oVal;
        });
        [...selectOrigen.options].forEach(opt => {
            if (!opt.value) return;
            opt.disabled = opt.value === dVal;
        });
    }

    selectOrigen.addEventListener('change', syncOptions);
    selectDestino.addEventListener('change', syncOptions);
    syncOptions();
</script>
}
