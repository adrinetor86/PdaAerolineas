@{
    ViewData["Title"] = "Radar de Flota Global";
}

<style>
    .leaflet-container img,
    .leaflet-tile {
        max-width: none !important;
        max-height: none !important;
    }
</style>

<div class="max-w-full mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between gap-4 mb-4">
        <div>
            <h2 class="text-2xl font-extrabold tracking-tight text-gray-900">Radar de Flota en Directo</h2>
            <p class="text-xs font-mono text-gray-400">Monitorizando <span id="count-aviones">0</span> aeronaves en tiempo real</p>
        </div>

        <div class="flex gap-2">
            <span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Sincronizado</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4">
        <div class="lg:col-span-3">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm ring-1 ring-gray-900/5">
                <div id="map" style="height: 100vh; width: 100%;"></div>
            </div>
        </div>
        
  
        <div class="lg:col-span-1 space-y-4">
            <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-4">
                <h3 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-3">Conexión Hub</h3>
                <div id="trackingStatus" class="flex items-center gap-2 text-sm font-bold text-gray-900">
                    <span class="relative flex h-3 w-3"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span><span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span></span>
                    Conectando a SignalR...
                </div>
            </div>

            <!-- Ayuda de selección -->
            <div class="rounded-xl border border-blue-100 bg-blue-50/50 p-3">
                <div class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-[10px] text-blue-700 leading-relaxed">
                        <b>Click en un avión</b> para ver su ruta, aeropuertos de origen/destino y progreso en el mapa. Click en el mapa para deseleccionar.
                    </p>
                </div>
            </div>

            <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
                <div class="bg-gray-50 px-4 py-2 border-b border-gray-200">
                    <h3 class="text-[10px] font-black text-gray-500 uppercase">Tráfico Activo</h3>
                </div>
                <div id="lista-vuelos" class="divide-y divide-gray-100 max-h-[400px] overflow-y-auto">
         
                    <div class="p-4 text-center text-xs text-gray-400 italic">Esperando datos de telemetría...</div>
                </div>
            </div>

            <!-- Leyenda -->
            <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-3">
                <h3 class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Leyenda</h3>
                <div class="space-y-1.5 text-[10px]">
                    <div class="flex items-center gap-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#2563eb"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
                        <span class="text-gray-600">Avión en vuelo</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="#dc2626"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
                        <span class="text-gray-600">Avión seleccionado</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-3.5 h-0.5 bg-amber-400 rounded" style="border-top: 2px dashed #f59e0b;"></div>
                        <span class="text-gray-600">Ruta planificada</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-3.5 h-0.5 bg-green-500 rounded"></div>
                        <span class="text-gray-600">Tramo recorrido</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-2.5 h-2.5 rounded-full bg-green-500"></div>
                        <span class="text-gray-600">Aeropuerto origen</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
                        <span class="text-gray-600">Aeropuerto destino</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        window.RADAR_CONFIG = {
            hubUrl: "/hubs/vuelos",
       
            bootstrapUrl: '@Url.Action("GetAllTracking", "Telemetria")' 
        };
    </script>
    <script src="~/js/radar-flota.js"></script>
}