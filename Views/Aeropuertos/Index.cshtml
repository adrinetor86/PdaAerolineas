@model List<PdaAerolineas.Models.Aeropuerto>

@{
    ViewData["Title"] = "Gestión de Aeropuertos";
    var currentBusqueda = ViewData["BUSQUEDA"]?.ToString();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">Gestión de Aeropuertos</h2>
          
        </div>
        
        <div class="flex items-center gap-3">
            <form method="get" class="relative group">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" name="busqueda" value="@currentBusqueda" placeholder="IATA, ICAO o Ciudad..."
                       class="pl-10 pr-4 py-2 text-sm bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all w-64 shadow-sm" />
            </form>
        </div>
    </div>

    @* TABLA *@
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 font-bold uppercase tracking-wider text-[10px]">
                    <tr>
                        <th class="px-6 py-4">Identificadores</th>
                        <th class="px-6 py-4">Nombre del Aeropuerto</th>
                        <th class="px-6 py-4">Ubicación</th>
                        <th class="px-6 py-4">Coordenadas (Lat/Lon)</th>
                        <th class="px-6 py-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-gray-400">
                                No se encontraron aeropuertos con los criterios de búsqueda.
                            </td>
                        </tr>
                    }
                    @foreach (var aero in Model)
                    {
                        <tr class="hover:bg-gray-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="bg-gray-900 text-white text-[10px] font-black px-1.5 py-0.5 rounded">@aero.Cod_Iata</span>
                                    <span class="bg-blue-100 text-blue-700 text-[10px] font-black px-1.5 py-0.5 rounded">@aero.Cod_Icao</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-bold text-gray-900">@aero.Nombre</div>
                            </td>
                            <td class="px-6 py-4 text-gray-600">
                                @aero.Ciudad
                            </td>
                            <td class="px-6 py-4 font-mono text-[11px] text-gray-400">
                                <span class="text-gray-600">@aero.Latitud.ToString("F4")</span>, 
                                <span class="text-gray-600">@aero.Longitud.ToString("F4")</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a asp-action="Clima" asp-route-iata="@aero.Cod_Icao" 
                                       class="p-2 text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors" title="Clima Realtime">
                                        Ver Información Metar
                                    </a>
                                    
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>