
@model List<Aeropuerto>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Aeropuertos";
    var paginaActual   = ViewData["PAGINA_ACTUAL"] as int? ?? 1;
    var totalPaginas   = ViewData["TOTAL_PAGINAS"] as int? ?? 1;
    var totalRegistros = ViewData["TOTAL_REGISTROS"] as int? ?? 0;
    var registrosPag   = ViewData["REGISTROS_PAG"] as int? ?? 10;
    var busqueda       = ViewData["BUSQUEDA"] as string ?? string.Empty;

    var inicioRegistro = totalRegistros == 0 ? 0 : (paginaActual - 1) * registrosPag + 1;
    var finRegistro    = Math.Min(totalRegistros, paginaActual * registrosPag);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-black text-slate-900">Aeropuertos</h1>
            <p class="text-sm text-slate-500">Listado con búsqueda y paginación.</p>
        </div>
        @if (ClaimsExtensions.IsAdmin(User))
        {
            <a asp-controller="Aeropuertos"
               asp-action="Create" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">
                + Nuevo aeropuerto
            </a>
        }
    </div>

    <form method="get" asp-action="Aeropuertos" id="formFiltros" class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <input type="hidden" name="numPag" id="inputNumPag" value="@paginaActual" />

        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-slate-50/70 px-5 py-3">
            <div class="flex flex-wrap items-center gap-2">
                <a href="@Url.Action("Aeropuertos", "Aeropuertos")"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 hover:border-red-400 hover:text-red-500 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                    </svg>
                    Limpiar
                </a>

                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200">
                        "@busqueda"
                        <button type="button" onclick="clearField('busqueda')" class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                    </span>
                }
            </div>

            <div class="relative">
                <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" name="busqueda" value="@busqueda" placeholder="Buscar nombre, IATA, ICAO, ciudad"
                       onkeydown="if(event.key==='Enter'){ resetPage(); this.form.submit(); }"
                       class="w-64 rounded-lg border py-1.5 pl-9 pr-4 text-xs font-mono outline-none transition-all focus:w-80 @(!string.IsNullOrEmpty(busqueda) ? "border-blue-400 bg-blue-50 text-blue-700 ring-1 ring-blue-200" : "border-gray-300 bg-white text-gray-700 focus:border-blue-400 focus:ring-1 focus:ring-blue-100")" />
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-4 py-3 font-semibold">Código</th>
                        <th class="px-4 py-3 font-semibold">Aeropuerto</th>
                        <th class="px-4 py-3 font-semibold">Ciudad</th>
                        <th class="px-4 py-3 font-semibold">Coordenadas</th>
                        <th class="px-4 py-3 font-semibold text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-4 py-6 text-center text-sm text-slate-400">No se encontraron aeropuertos.</td>
                    </tr>
                }
                else
                {
                    foreach (var a in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 text-sm font-semibold text-slate-900">
                                <div class="font-mono text-xs">IATA: @a.Cod_Iata</div>
                                <div class="font-mono text-[11px] text-slate-500">ICAO: @a.Cod_Icao</div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="text-sm font-bold text-slate-900">@a.Nombre</div>
                                <div class="text-xs text-slate-500">ID @a.IdAeropuerto</div>
                            </td>
                            <td class="px-4 py-3 text-sm text-slate-800">@a.Ciudad</td>
                            <td class="px-4 py-3 text-xs font-mono text-slate-600">@a.Latitud, @a.Longitud</td>
                            
                            <td class="px-4 py-3 text-right">
                                <div class="flex justify-end gap-2"> 
                                    <a asp-action="Clima" asp-route-iata="@a.Cod_Icao"
                                       class="p-2 text-amber-600 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors" title="Clima Realtime">
                                        Ver Información Metar
                                    </a>
                                
                                </div>
                            </td>   
                            
                            @if (ClaimsExtensions.IsAdmin(User))
                            {
                                <td class="px-4 py-3 text-right">
                                    <a asp-controller="Aeropuertos"
                                       asp-action="Update"
                                       asp-route-idAeropuerto="@a.IdAeropuerto" class="inline-flex items-center gap-1 rounded-lg bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200 hover:bg-blue-100">
                                        Editar
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 bg-slate-50/70 px-5 py-3">
            <p class="font-mono text-xs text-gray-500">
                Mostrando <strong class="text-gray-800">@inicioRegistro</strong>
                a <strong class="text-gray-800">@finRegistro</strong>
                de <strong class="text-gray-800">@totalRegistros</strong> aeropuertos
            </p>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1">
                    <button type="button" onclick="cambiarPagina(1)" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">«</button>
                    <button type="button" onclick="cambiarPagina(@(paginaActual - 1))" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">‹</button>

                    @{
                        var rng = 2;
                        var start = Math.Max(1, paginaActual - rng);
                        var end = Math.Min(totalPaginas, paginaActual + rng);
                    }

                    @if (start > 1)
                    {
                        <button type="button" onclick="cambiarPagina(1)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">1</button>
                        if (start > 2)
                        {
                            <span class="px-1 font-mono text-xs text-gray-400">…</span>
                        }
                    }

                    @for (var p = start; p <= end; p++)
                    {
                        if (p == paginaActual)
                        {
                            <button type="button" onclick="cambiarPagina(@p)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-900 bg-gray-900 font-mono text-xs font-bold text-white">@p</button>
                        }
                        else
                        {
                            <button type="button" onclick="cambiarPagina(@p)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@p</button>
                        }
                    }

                    @if (end < totalPaginas)
                    {
                        if (end < totalPaginas - 1)
                        {
                            <span class="px-1 font-mono text-xs text-gray-400">…</span>
                        }
                        <button type="button" onclick="cambiarPagina(@totalPaginas)" class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@totalPaginas</button>
                    }

                    <button type="button" onclick="cambiarPagina(@(paginaActual + 1))" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">›</button>
                    <button type="button" onclick="cambiarPagina(@totalPaginas)" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">»</button>
                </div>

                <div class="relative">
                    <select name="numFilas" onchange="resetPage(); this.form.submit()"
                            class="appearance-none cursor-pointer rounded-lg border border-gray-300 bg-white py-1.5 pl-3 pr-7 font-mono text-xs text-gray-700 outline-none transition-all hover:border-gray-400 focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                        <option value="5" selected="@(registrosPag == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(registrosPag == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(registrosPag == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(registrosPag == 50 ? "selected" : null)">50</option>
                    </select>
                    <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    function cambiarPagina(num) {
        if (num < 1) return;
        document.getElementById('inputNumPag').value = num;
        document.getElementById('formFiltros').submit();
    }
    function resetPage() {
        document.getElementById('inputNumPag').value = 1;
    }
    function clearField(fieldName) {
        const form = document.getElementById('formFiltros');
        const input = form.querySelector(`[name="${fieldName}"]`);
        if (input) input.value = '';
        resetPage();
        form.submit();
    }
</script>
}
