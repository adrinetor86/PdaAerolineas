@{
    Layout = "_Layout";
    ViewData["Title"] = "Acceso Denegado";
}

<style>
    @@keyframes ping-slow {
        0%   { transform: scale(1); opacity: 0.5; }
        100% { transform: scale(1.9); opacity: 0; }
    }
    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
    }
    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes scan {
        0%   { top: -2px; }
        100% { top: 100%; }
    }

    .ping-slow  { animation: ping-slow 2s cubic-bezier(0,0,0.2,1) infinite; }
    .blink      { animation: blink 1s step-end infinite; }
    .slide-1    { animation: slideUp 0.5s ease both; }
    .slide-2    { animation: slideUp 0.5s 0.12s ease both; }
    .slide-3    { animation: slideUp 0.5s 0.24s ease both; }
    .slide-4    { animation: slideUp 0.5s 0.36s ease both; }
    .scan-line  {
        position: absolute; left: 0; right: 0; height: 2px;
        background: linear-gradient(90deg, transparent, rgba(220,38,38,0.5), transparent);
        animation: scan 3s linear infinite;
    }
</style>

<div class="min-h-[80vh] flex items-center justify-center px-4">

    <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden">
        <div class="w-[500px] h-[500px] rounded-full bg-red-100 opacity-30 blur-3xl"></div>
    </div>

    <div class="relative z-10 w-full max-w-md text-center">

        <div class="slide-1 flex justify-center mb-8">
            <div class="relative flex items-center justify-center">
                <span class="ping-slow absolute inline-flex h-28 w-28 rounded-full bg-red-200"></span>
                <span class="ping-slow absolute inline-flex h-28 w-28 rounded-full bg-red-100" style="animation-delay:0.7s"></span>

                <div class="relative z-10 w-20 h-20 rounded-full bg-red-50 border-2 border-red-200 flex items-center justify-center shadow-lg shadow-red-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="slide-2 font-mono text-red-400 text-xs tracking-[0.35em] uppercase mb-3">
            ERROR 403 <span class="blink">_</span>
        </div>

        <h1 class="slide-2 text-3xl font-extrabold text-gray-900 tracking-tight mb-3">
            Acceso Denegado
        </h1>
        <p class="slide-3 text-sm text-gray-500 leading-relaxed mb-8">
            No tienes los permisos necesarios para ver esta sección.<br>
            Si crees que es un error, contacta con un administrador.
        </p>
        
    </div>
</div>

@section Scripts {
<script>
    // Timestamp en tiempo real
    const el = document.getElementById('ts');
    const fmt = () => new Date().toLocaleString('es-ES', {
        day:'2-digit', month:'2-digit', year:'numeric',
        hour:'2-digit', minute:'2-digit', second:'2-digit'
    });
    el.textContent = fmt();
    setInterval(() => el.textContent = fmt(), 1000);
</script>
}
