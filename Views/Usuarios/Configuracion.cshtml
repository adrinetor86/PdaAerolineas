@model PdaAerolineas.Models.Views.VistaAdministracionUsuarios

@{
    Layout = "_Layout";
    ViewData["Title"] = "Configuración";
    var iniciales = (Model.Nombre?.Substring(0, 1) ?? "") + (Model.Apellidos?.Substring(0, 1) ?? "");
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">

    <div class="mb-6">
        <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Configuración</h1>
        <p class="text-sm text-gray-500 mt-1">Gestiona tu perfil y sesión</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Tarjeta de Perfil -->
        <div class="lg:col-span-2">
            <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-8">
                    <div class="flex items-center gap-5">
                        <img src="~/Images/Perfi/perfil.png"
                             alt="Foto de perfil"
                             class="flex-shrink-0 h-16 w-16 rounded-full object-cover ring-2 ring-white/30"/>
                        <div>
                            <h2 class="text-xl font-bold text-white">@Model.Nombre @Model.Apellidos</h2>
                            <p class="text-blue-100 text-sm">@Model.Email</p>
                        </div>
                    </div>
                </div>

                <div class="p-6 space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Nombre</label>
                            <div class="text-sm font-medium text-gray-900 bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">@Model.Nombre</div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Apellidos</label>
                            <div class="text-sm font-medium text-gray-900 bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">@Model.Apellidos</div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Email</label>
                            <div class="text-sm font-medium text-gray-900 bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">@Model.Email</div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Rol</label>
                            <div class="text-sm font-medium text-gray-900 bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">
                                <span class="inline-flex items-center gap-1.5">
                                    <span class="h-2 w-2 rounded-full @(Model.Rol == "Administrador" ? "bg-red-500" : "bg-blue-500")"></span>
                                    @Model.Rol
                                </span>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Aerolínea</label>
                            <div class="text-sm font-medium text-gray-900 bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">@Model.Aerolinea</div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Estado</label>
                            <div class="text-sm font-medium bg-gray-50 rounded-lg px-4 py-2.5 border border-gray-100">
                                @if (Model.Activo)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-green-700">
                                        <span class="h-2 w-2 rounded-full bg-green-500"></span>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-red-700">
                                        <span class="h-2 w-2 rounded-full bg-red-500"></span>
                                        Inactivo
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Acciones -->
        <div class="lg:col-span-1 space-y-4">
            
            <!-- Card Sesión -->
            <div class="rounded-xl border border-gray-200 bg-white shadow-sm p-5">
                <div class="flex items-center gap-2 mb-3">
                    <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182" />
                    </svg>
                    <h3 class="text-sm font-bold text-gray-900">Resetear Sesión</h3>
                </div>
                <p class="text-xs text-gray-500 mb-4">
                    Recarga los datos de tu sesión (rol y aerolínea) desde la base de datos. 
                    Útil si un administrador ha modificado tus permisos.
                </p>
                <form method="post" asp-action="ResetearSession">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Id">
                    <button type="submit"
                            class="w-full inline-flex justify-center items-center gap-2 rounded-lg bg-amber-50 border border-amber-200 px-4 py-2.5 text-sm font-semibold text-amber-700 hover:bg-amber-100 transition">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182" />
                        </svg>
                        Resetear Sesión
                    </button>
                </form>
            </div>

            <!-- Card Cerrar Sesión -->
            <div class="rounded-xl border border-red-100 bg-white shadow-sm p-5">
                <div class="flex items-center gap-2 mb-3">
                    <svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                    </svg>
                    <h3 class="text-sm font-bold text-gray-900">Cerrar Sesión</h3>
                </div>
                <p class="text-xs text-gray-500 mb-4">
                    Cierra tu sesión actual y vuelve a la pantalla de inicio de sesión.
                </p>
                <a asp-controller="Usuarios" asp-action="LogOut"
                   class="w-full inline-flex justify-center items-center gap-2 rounded-lg bg-red-50 border border-red-200 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-100 transition">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
                    </svg>
                    Cerrar Sesión
                </a>
            </div>

        </div>
    </div>
</div>