@model PdaAerolineas.Models.ViewModels.FinanzasDashboardViewModel
@{
    ViewData["Title"] = "Finanzas";
    var resumen = Model.Resumen;
    var vuelosRecientesCount = (Model.DetalleVuelos ?? new List<PdaAerolineas.Repositories.FinanzasVueloDetalle>())
        .OrderByDescending(x => x.FechaSalida)
        .Take(12)
        .Count();

    var paginaActual   = ViewData["PAGINA_ACTUAL"] as int? ?? 1;
    var totalPaginas   = ViewData["TOTAL_PAGINAS"] as int? ?? 1;
    var totalRegistros = ViewData["TOTAL_REGISTROS"] as int? ?? 0;
    var registrosPag   = ViewData["REGISTROS_PAG"] as int? ?? 10;

    var inicioRegistro = totalRegistros == 0 ? 0 : (paginaActual - 1) * registrosPag + 1;
    var finRegistro    = Math.Min(totalRegistros, paginaActual * registrosPag);
}

<div class="p-6">
    <div class="mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Gestión financiera</h1>
            <p class="text-gray-600 mt-1">Control de ingresos y costes por vuelo</p>
        </div>
    </div>

    @if (resumen != null)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-emerald-500">
                <div class="text-sm text-gray-600 mb-1">Total vuelos</div>
                <div class="text-2xl font-bold text-gray-900">@resumen.TotalVuelos</div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-emerald-500">
                <div class="text-sm text-gray-600 mb-1">Total ingresos</div>
                <div class="text-2xl font-bold text-gray-900">@resumen.TotalIngresos.ToString("C2")</div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-emerald-500">
                <div class="text-sm text-gray-600 mb-1">Total costes</div>
                <div class="text-2xl font-bold text-gray-900">@resumen.TotalCostes.ToString("C2")</div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-emerald-500">
                <div class="text-sm text-gray-600 mb-1">Beneficio total</div>
                <div class="text-2xl font-bold text-gray-900">@resumen.BeneficioTotal.ToString("C2")</div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-emerald-500">
                <div class="text-sm text-gray-600 mb-1">Beneficio promedio</div>
                <div class="text-2xl font-bold text-gray-900">@resumen.BeneficioPromedio.ToString("C2")</div>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900">Ingresos vs costes (últimos vuelos)</h2>
                <span class="text-xs text-gray-500">@vuelosRecientesCount vuelo(s)</span>
            </div>
            <div class="p-6" style="height: 320px;">
                <canvas id="chartIngresosCostes"></canvas>
                @if (string.IsNullOrWhiteSpace(Model.LabelsVuelosJson) || Model.LabelsVuelosJson == "[]")
                {
                    <p class="text-sm text-gray-500 mt-4">No hay datos suficientes para mostrar el gráfico.</p>
                }
            </div>
        </div>

        <div class="bg-white rounded-lg shadow overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900">Beneficio por día</h2>
                <span class="text-xs text-gray-500">últimos 30 días con actividad</span>
            </div>
            <div class="p-6" style="height: 320px;">
                <canvas id="chartBeneficio"></canvas>
                @if (string.IsNullOrWhiteSpace(Model.LabelsDiasJson) || Model.LabelsDiasJson == "[]")
                {
                    <p class="text-sm text-gray-500 mt-4">No hay datos suficientes para mostrar el gráfico.</p>
                }
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-gray-900">Detalle de vuelos</h2>

            <form method="get" id="formPaginacion" class="flex items-center gap-3">
                <input type="hidden" name="numPag" id="inputNumPag" value="@paginaActual" />

                <p class="text-xs text-gray-500">
                    Mostrando <strong>@inicioRegistro</strong> a <strong>@finRegistro</strong> de <strong>@totalRegistros</strong>
                </p>

                <div class="flex items-center gap-2">
                    <label class="text-xs text-gray-500">Filas</label>
                    <select name="numFilas" onchange="resetPage(); this.form.submit()"
                            class="appearance-none cursor-pointer rounded-lg border border-gray-300 bg-white py-1.5 pl-3 pr-7 font-mono text-xs text-gray-700 outline-none transition-all hover:border-gray-400 focus:border-emerald-400 focus:ring-1 focus:ring-emerald-100">
                        <option value="5"  selected="@(registrosPag == 5 ? "selected" : null)">5</option>
                        <option value="10" selected="@(registrosPag == 10 ? "selected" : null)">10</option>
                        <option value="20" selected="@(registrosPag == 20 ? "selected" : null)">20</option>
                        <option value="50" selected="@(registrosPag == 50 ? "selected" : null)">50</option>
                    </select>
                </div>
            </form>
        </div>

        @if (Model.DetalleVuelos != null && Model.DetalleVuelos.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vuelo</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ruta</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Ingresos</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Costes</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Beneficio</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Margen</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var item in Model.DetalleVuelos)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@item.NumeroVuelo</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@item.Ruta</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@item.FechaSalida.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <div class="text-sm text-gray-900 font-medium">@item.IngresoPasajes.ToString("C2")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <div class="text-sm text-gray-900 font-medium">@item.CosteTotal.ToString("C2")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <div class="text-sm font-bold text-gray-900">@item.BeneficioNeto.ToString("C2")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <div class="text-sm text-gray-900">@item.MargenPorcentaje.ToString("F2")%</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <a asp-action="Detalle" asp-route-vueloId="@item.VueloId" 
                                       class="text-emerald-700 hover:text-emerald-900 text-sm font-medium">
                                        Ver detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                <p class="text-xs text-gray-500">Página @paginaActual</p>

                <div class="flex items-center gap-2 justify-end ml-auto">
                    <button type="button" onclick="cambiarPagina(1)" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-emerald-400 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-30">«</button>
                    <button type="button" onclick="cambiarPagina(@(paginaActual - 1))" @(paginaActual <= 1 ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-emerald-400 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-30">‹</button>
                    <span class="text-xs text-gray-500">@paginaActual / @totalPaginas</span>
                    <button type="button" onclick="cambiarPagina(@(paginaActual + 1))" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-emerald-400 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-30">›</button>
                    <button type="button" onclick="cambiarPagina(@totalPaginas)" @(paginaActual >= totalPaginas ? "disabled" : "")
                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-emerald-400 hover:text-emerald-700 disabled:cursor-not-allowed disabled:opacity-30">»</button>
                </div>
            </div>
        }
        else
        {
            <div class="px-6 py-8 text-center text-gray-500">
                <p>No hay datos financieros disponibles.</p>
                <p class="text-sm mt-2">Los datos se generan automáticamente al completar vuelos.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        function cambiarPagina(num) {
            if (num < 1) return;
            document.getElementById('inputNumPag').value = num;
            document.getElementById('formPaginacion').submit();
        }
        function resetPage() {
            document.getElementById('inputNumPag').value = 1;
        }

        (function() {
            const labelsVuelos = @Html.Raw(Model.LabelsVuelosJson);
            const ingresosVuelos = @Html.Raw(Model.IngresosVuelosJson);
            const costesVuelos = @Html.Raw(Model.CostesVuelosJson);

            const labelsDias = @Html.Raw(Model.LabelsDiasJson);
            const beneficiosDias = @Html.Raw(Model.BeneficiosDiasJson);

            const commonGrid = { color: 'rgba(148, 163, 184, 0.25)' };

            const ctx1 = document.getElementById('chartIngresosCostes');
            if (ctx1 && labelsVuelos && labelsVuelos.length) {
                new Chart(ctx1, {
                    type: 'bar',
                    data: {
                        labels: labelsVuelos,
                        datasets: [
                            {
                                label: 'Ingresos',
                                data: ingresosVuelos,
                                backgroundColor: 'rgba(16, 185, 129, 0.35)',
                                borderColor: 'rgba(16, 185, 129, 1)',
                                borderWidth: 1
                            },
                            {
                                label: 'Costes',
                                data: costesVuelos,
                                backgroundColor: 'rgba(34, 197, 94, 0.22)',
                                borderColor: 'rgba(34, 197, 94, 1)',
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function(ctx) {
                                        const v = ctx.raw ?? 0;
                                        return `${ctx.dataset.label}: ${Number(v).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' })}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                ticks: {
                                    callback: function(value) {
                                        return Number(value).toLocaleString('es-ES', { notation: 'compact' });
                                    }
                                },
                                grid: commonGrid
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            const ctx2 = document.getElementById('chartBeneficio');
            if (ctx2 && labelsDias && labelsDias.length) {
                new Chart(ctx2, {
                    type: 'line',
                    data: {
                        labels: labelsDias,
                        datasets: [
                            {
                                label: 'Beneficio',
                                data: beneficiosDias,
                                borderColor: 'rgba(16, 185, 129, 1)',
                                backgroundColor: 'rgba(16, 185, 129, 0.12)',
                                tension: 0.25,
                                pointRadius: 3,
                                pointHoverRadius: 5,
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: function(ctx) {
                                        const v = ctx.raw ?? 0;
                                        return `Beneficio: ${Number(v).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' })}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                ticks: {
                                    callback: function(value) {
                                        return Number(value).toLocaleString('es-ES', { notation: 'compact' });
                                    }
                                },
                                grid: commonGrid
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        })();
    </script>
}
