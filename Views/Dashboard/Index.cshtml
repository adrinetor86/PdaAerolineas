    // ====== VUELOS POR ESTADO ======
    new ApexCharts(document.querySelector("#chartVuelosPorEstado"), {
        series: vuelosPorEstado.map(d => d.total),
        labels: vuelosPorEstado.map(d => d.estado),
        chart: {
