                }
            }
        }
    }).render();

    // ====== AERONAVES POR ESTADO ======
    new ApexCharts(document.querySelector("#chartAeronavesPorEstado"), {
        series: aeronavesPorEstado.map(d => d.total),
        labels: aeronavesPorEstado.map(d => d.estado),
