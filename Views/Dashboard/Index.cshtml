            fontFamily: 'Inter, system-ui, sans-serif'
        },
        colors: ['#10b981', '#f59e0b', '#3b82f6', '#ef4444'],
        legend: {
            position: 'bottom',
            fontSize: '13px'
        },
        dataLabels: {
            enabled: true,
            formatter: function(val, opts) {
