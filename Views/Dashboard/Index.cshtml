@model PdaAerolineas.Models.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="min-h-screen bg-gray-50 p-6">

    <div class="max-w-7xl mx-auto">

        <!-- HEADER -->
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
            <p class="text-gray-600 mt-1">Resumen general del sistema</p>
        </div>

        <!-- TARJETAS DE ESTADÍSTICAS -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">

            <!-- Vuelos Hoy -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wider">Vuelos Hoy</p>
                        <p class="text-3xl font-bold text-gray-900 mt-2">@Model.VuelosHoy</p>
                    </div>
                    <div class="bg-blue-100 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    <span class="text-green-600 font-semibold">@Model.VuelosEnVuelo en vuelo</span>
                </p>
            </div>

            <!-- Pasajeros Hoy -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wider">Pasajeros Hoy</p>
                        <p class="text-3xl font-bold text-gray-900 mt-2">@Model.PasajerosHoy.ToString("N0")</p>
                    </div>
                    <div class="bg-green-100 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    <span class="font-semibold">@Model.OcupacionPromedio.ToString("F1")%</span> ocupación promedio
                </p>
            </div>

            <!-- Aeronaves Operativas -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wider">Aeronaves</p>
                        <p class="text-3xl font-bold text-gray-900 mt-2">@Model.AeronavesOperativas</p>
                    </div>
                    <div class="bg-purple-100 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    <span class="text-amber-600 font-semibold">@Model.AeronavesEnMantenimiento en mantenimiento</span>
                </p>
            </div>

            <!-- Mantenimientos -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wider">Mantenimientos</p>
                        <p class="text-3xl font-bold text-gray-900 mt-2">@Model.MantenimientosActivos</p>
                    </div>
                    <div class="bg-orange-100 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                </div>
                <p class="text-xs text-gray-500 mt-4">
                    <span class="font-semibold">@Model.MantenimientosPendientes pendientes</span>
                </p>
            </div>

        </div>

        <!-- GRÁFICOS -->
        <div class="grid lg:grid-cols-2 gap-6 mb-6">

            <!-- Vuelos por Hora -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Vuelos por Hora (Hoy)</h3>
                <div id="chartVuelosPorHora"></div>
            </div>

            <!-- Ocupación Semanal -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Ocupación Última Semana</h3>
                <div id="chartOcupacionSemanal"></div>
            </div>

        </div>

        <div class="grid lg:grid-cols-2 gap-6 mb-6">

            <!-- Vuelos por Estado -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Vuelos por Estado</h3>
                <div id="chartVuelosPorEstado"></div>
            </div>

            <!-- Aeronaves por Estado -->
            <div class="bg-white border border-gray-200 rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Estado de Aeronaves</h3>
                <div id="chartAeronavesPorEstado"></div>
            </div>

        </div>

        <!-- TABLAS -->
        <div class="grid lg:grid-cols-2 gap-6">

            <!-- Próximos Vuelos -->
            <div class="bg-white border border-gray-200 rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900">Próximos Vuelos</h3>
                </div>
                <div class="divide-y divide-gray-200">
                    @if (Model.ProximosVuelos != null && Model.ProximosVuelos.Any())
                    {
                        @foreach (var vuelo in Model.ProximosVuelos)
                        {
                            <div class="px-6 py-4 hover:bg-gray-50 transition">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <p class="font-bold text-gray-900">@vuelo.NumeroVuelo</p>
                                        <p class="text-sm text-gray-600">@vuelo.Ruta</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-semibold text-gray-900">@vuelo.FechaSalida.ToString("HH:mm")</p>
                                        <p class="text-xs text-gray-500">Puerta @vuelo.Puerta</p>
                                    </div>
                                </div>
                                <div class="mt-2 flex items-center gap-2">
                                    <div class="flex-1 bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" 
                                             style="width: @vuelo.PorcentajeOcupacion%"></div>
                                    </div>
                                    <span class="text-xs text-gray-600">@vuelo.PasajerosConfirmados/@vuelo.CapacidadTotal</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="px-6 py-8 text-center text-gray-500">
                            <p>No hay vuelos próximos</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Top Rutas -->
            <div class="bg-white border border-gray-200 rounded-lg">
                <div class="px-6 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900">Top Rutas (Último Mes)</h3>
                </div>
                <div class="divide-y divide-gray-200">
                    @if (Model.TopRutas != null && Model.TopRutas.Any())
                    {
                        @foreach (var ruta in Model.TopRutas)
                        {
                            <div class="px-6 py-4 hover:bg-gray-50 transition">
                                <div class="flex justify-between items-center">
                                    <div>
                                        <p class="font-bold text-gray-900">@ruta.Ruta</p>
                                        <p class="text-sm text-gray-600">@ruta.TotalPasajeros.ToString("N0") pasajeros</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-bold text-blue-600">@ruta.TotalVuelos</p>
                                        <p class="text-xs text-gray-500">vuelos</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="px-6 py-8 text-center text-gray-500">
                            <p>No hay datos de rutas</p>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <script>
    // Datos del servidor
    const vuelosPorHora = @Html.Raw(Model.VuelosPorHoraJson ?? "[]");
    const vuelosPorEstado = @Html.Raw(Model.VuelosPorEstadoJson ?? "[]");
    const ocupacionSemanal = @Html.Raw(Model.OcupacionSemanalJson ?? "[]");
    const aeronavesPorEstado = @Html.Raw(Model.AeronavesPorEstadoJson ?? "[]");

    // ====== VUELOS POR HORA ======
    new ApexCharts(document.querySelector("#chartVuelosPorHora"), {
        series: [{
            name: 'Vuelos',
            data: vuelosPorHora.map(d => d.vuelos)
        }],
        chart: {
            type: 'bar',
            height: 300,
            toolbar: { show: false },
            fontFamily: 'Inter, system-ui, sans-serif'
        },
        colors: ['#3b82f6'],
        plotOptions: {
            bar: {
                borderRadius: 4,
                columnWidth: '60%'
            }
        },
        xaxis: {
            categories: vuelosPorHora.map(d => d.hora),
            labels: {
                style: {
                    colors: '#6b7280',
                    fontSize: '12px'
                }
            }
        },
        yaxis: {
            title: { 
                text: 'Cantidad de Vuelos',
                style: {
                    color: '#374151',
                    fontSize: '13px',
                    fontWeight: 600
                }
            },
            labels: {
                style: {
                    colors: '#6b7280'
                }
            }
        },
        grid: {
            borderColor: '#e5e7eb',
            strokeDashArray: 3
        },
        dataLabels: {
            enabled: false
        }
    }).render();

    // ====== OCUPACIÓN SEMANAL ======
    new ApexCharts(document.querySelector("#chartOcupacionSemanal"), {
        series: [{
            name: 'Ocupación %',
            data: ocupacionSemanal.map(d => parseFloat(d.ocupacion.toFixed(1)))
        }],
        chart: {
            type: 'line',
            height: 300,
            toolbar: { show: false },
            fontFamily: 'Inter, system-ui, sans-serif'
        },
        stroke: {
            curve: 'smooth',
            width: 3
        },
        colors: ['#10b981'],
        markers: {
            size: 5,
            colors: ['#10b981'],
            strokeWidth: 2,
            strokeColors: '#fff'
        },
        xaxis: {
            categories: ocupacionSemanal.map(d => d.fecha),
            labels: {
                style: {
                    colors: '#6b7280',
                    fontSize: '12px'
                }
            }
        },
        yaxis: {
            min: 0,
            max: 100,
            title: { 
                text: 'Ocupación (%)',
                style: {
                    color: '#374151',
                    fontSize: '13px',
                    fontWeight: 600
                }
            },
            labels: {
                formatter: function(val) {
                    return val.toFixed(0) + '%';
