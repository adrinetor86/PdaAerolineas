@model PdaAerolineas.Models.Resumenes.FlotaResumen

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Dashboard de Flota</h1>
            <p class="text-gray-600">Iberia - Vista general de operaciones</p>
        </div>
        <!-- Cards de Estadísticas -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            
            <!-- Total Flota -->
            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500 hover:shadow-xl transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Total Flota</p>
                        <p class="text-3xl font-bold text-gray-900 mt-2">@Model.NumeroFlota</p>
                    </div>
                </div>
            </div>

            <!-- Aviones Operativos -->
            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500 hover:shadow-xl transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Operativos</p>
                        <p class="text-3xl font-bold text-green-600 mt-2">@Model.AvionesOperativos</p>
                        <p class="text-xs text-gray-500 mt-1">
                            @(Model.NumeroFlota > 0 ? Math.Round((decimal)Model.AvionesOperativos / Model.NumeroFlota * 100, 1) : 0)% del total
                        </p>
                    </div>
                </div>
            </div>

            <!-- Vuelos Activos -->
            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-purple-500 hover:shadow-xl transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Vuelos Activos</p>
                        <p class="text-3xl font-bold text-purple-600 mt-2">@Model.VuelosActivos</p>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 mt-2">
                            En tiempo real
                        </span>
                    </div>
                </div>
            </div>

            <!-- En Mantenimiento -->
            <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-orange-500 hover:shadow-xl transition-shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-600 uppercase tracking-wide">Mantenimiento</p>
                        <p class="text-3xl font-bold text-orange-600 mt-2">@Model.AvionesMantenimiento</p>
                    </div>
                </div>
            </div>

        </div>

        <!-- Tabla de Flota -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            
            <!-- Header de la tabla -->
            <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-indigo-600">
                <h2 class="text-xl font-bold text-white">Flota Actual</h2>
            </div>

            <!-- Tabla responsive -->
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Matrícula</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Modelo</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Capacidad</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ubicación</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Horas</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ciclos</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Próx. Mant.</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (Model.Flota != null && Model.Flota.Any())
                        {
                            @foreach (var avion in Model.Flota)
                            {
                                
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-3 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="flex-shrink-0 h-8 w-8 bg-blue-100 rounded-full flex items-center justify-center">
                                                <span class="text-blue-600 font-semibold text-xs">
                                                    @avion.Matricula.Substring(Math.Max(0, avion.Matricula.Length - 3))
                                                </span>
                                            </div>
                                            <div class="ml-3">
                                                <div class="text-sm font-medium text-gray-900">@avion.Matricula</div>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap">
                                        <div class="text-sm text-gray-900 font-medium">@avion.Fabricante</div>
                                        <div class="text-xs text-gray-500">@avion.NombreModelo</div>
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 font-semibold">
                                        @avion.CapacidadTotal
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap">
                                        @if (avion.Estado == "Operativo")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                 @avion.Estado
                                            </span>
                                        }
                                        else if (avion.Estado == "En Vuelo")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                 @avion.Estado
                                            </span>
                                        }
                                        else if (avion.Estado == "En Mantenimiento")
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                 @avion.Estado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                @avion.Estado
                                            </span>
                                        }
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap">
                                        
                                        @if (avion.IdEstadoAvion == 3)
                                        {
                                            <a class="text-blue-700 ">Ver posición</a>
                                        }else{
                                        <div class="text-sm text-gray-900 font-medium">@avion.CodigoAeropuerto</div>
                                        <div class="text-xs text-gray-500">@avion.Ubicacion</div>
                                        }
                                  
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 font-mono">
                                        @avion.HorasVueloTotales.ToString("N0")
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900 font-mono">
                                        @avion.CiclosTotales.ToString("N0")
                                    </td>
                                    
                                    <td class="px-4 py-3 whitespace-nowrap text-sm">
                                        @if (avion.ProximoMantenimiento != null)
                                        {
                                            <span class="text-gray-900">@avion.ProximoMantenimiento</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 italic">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="px-6 py-12 text-center">
                                    <p class="text-gray-500 text-lg">No hay aviones registrados</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer -->
            @if (Model.Flota != null && Model.Flota.Any())
            {
                <div class="bg-gray-50 px-6 py-3 border-t border-gray-200 flex justify-between text-sm">
                    <span class="text-gray-700">Mostrando <span class="font-medium">@Model.Flota.Count</span> aviones</span>
                    <span class="text-gray-500">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }

        </div>

    </div>
</div>