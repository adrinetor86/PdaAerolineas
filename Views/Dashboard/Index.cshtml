@*             } *@
@* *@
@*         </div> *@
@* *@
@*     </div> *@
@* </div> *@


@model PdaAerolineas.Models.Views.VistaDashboard
@{
    ViewData["Title"] = "Dashboard Operacional";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Centro de Control</h1>
            <p class="text-sm font-medium text-gray-500 mt-1">
                Visión general en tiempo real operaciones de <span class="text-blue-600 font-bold">@Model.Nombre</span>
            </p>
        </div>
        <div class="text-right">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Fecha Operativa</p>
            <p class="text-lg font-mono font-bold text-gray-800">@DateTime.Now.ToString("dd MMM yyyy")</p>
        </div>
    </div>

    <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Vuelos de Hoy</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-10">
        
        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-blue-50 text-blue-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase">Programados</p>
                    <p class="text-2xl font-black text-gray-900">@Model.VuelosProgramadosHoy</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-green-50 text-green-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2L8 8h3v8H5l-2 2v2l8-2 8 2v-2l-2-2h-6V8h3L12 2z"/></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase">En Curso</p>
                    <p class="text-2xl font-black text-gray-900">@Model.VuelosCurso</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-gray-50 text-gray-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase">Aterrizados</p>
                    <p class="text-2xl font-black text-gray-900">@Model.VuelosAterrizadosHoy</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-orange-50 text-orange-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase">Retrasados</p>
                    <p class="text-2xl font-black text-orange-600">@Model.VuelosRetrasadosHoy</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-red-50 text-red-600 rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </div>
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase">Cancelados</p>
                    <p class="text-2xl font-black text-red-600">@Model.VuelosCanceladosHoy</p>
                </div>
            </div>
        </div>

    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-6">Disponibilidad de Flota</h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div class="flex flex-col items-center justify-center p-6 bg-green-50/50 rounded-2xl border border-green-100">
                    <p class="text-4xl font-black text-green-600 mb-2">@Model.AvionesOperativos</p>
                    <p class="text-xs font-bold text-green-800 uppercase text-center">En Tierra<br/>(Operativos)</p>
                </div>
                
                <div class="flex flex-col items-center justify-center p-6 bg-blue-50/50 rounded-2xl border border-blue-100">
                    <p class="text-4xl font-black text-blue-600 mb-2">@Model.AvionesVueloHoy</p>
                    <p class="text-xs font-bold text-blue-800 uppercase text-center">En el Aire<br/>(Volando)</p>
                </div>
                
                <div class="flex flex-col items-center justify-center p-6 bg-orange-50/50 rounded-2xl border border-orange-100 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 opacity-10">
                        <svg class="w-24 h-24 text-orange-600" fill="currentColor" viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7c-1.1 2.4-.7 5.4 1.3 7.4 1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.8.8 2.1.8 2.8 0l.9-.9c.8-.8.8-2 0-2.8z"/></svg>
                    </div>
                    <p class="text-4xl font-black text-orange-600 mb-2 z-10">@Model.AvionesMantenimiento</p>
                    <p class="text-xs font-bold text-orange-800 uppercase text-center z-10">En Taller<br/>(Mantenimiento)</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between">
            <div>
                <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">Rendimiento Comercial</h2>
                <p class="text-xs text-gray-500 mb-6">Ocupación promedio de los vuelos programados para hoy.</p>
            </div>
            
            <div class="flex flex-col items-center justify-center flex-grow">
                <div class="relative flex items-center justify-center w-32 h-32 rounded-full border-8 @(Model.OcupacionPromedio >= 80 ? "border-green-500" : Model.OcupacionPromedio >= 60 ? "border-yellow-400" : "border-red-500") mb-4">
                    <span class="text-3xl font-black text-gray-800">@(Math.Round(Model.OcupacionPromedio))%</span>      
                    </div>
                
                @if(Model.OcupacionPromedio >= 80)
                {
                    <p class="text-sm font-bold text-green-600 flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" /></svg>
                        Alta Rentabilidad
                    </p>
                }
                else if(Model.OcupacionPromedio >= 60)
                {
                    <p class="text-sm font-bold text-yellow-600 flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Ocupación Moderada
                    </p>
                }
                else
                {
                    <p class="text-sm font-bold text-red-600 flex items-center gap-1">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
                        Baja Ocupación
                    </p>
                }
            </div>
        </div>

    </div>
</div>