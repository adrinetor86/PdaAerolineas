@{
    Layout = "_Layout";
}

<div class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center h-14">
            <nav class="flex items-center gap-1">
                <a asp-controller="PanelAdmin"
                   asp-action="Aerolineas"
                   class="px-3 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2
                          @(ViewContext.RouteData.Values["action"]?.ToString() == "Aerolineas"
                              ? "text-blue-600 bg-blue-50"
                              : "text-gray-500 hover:text-gray-900 hover:bg-gray-50")">
                    Aerolíneas
                </a>

                <a asp-controller="PanelAdmin"
                   asp-action="Usuarios"
                   class="px-3 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2
                          @(ViewContext.RouteData.Values["action"]?.ToString() == "Usuarios"
                              ? "text-blue-600 bg-blue-50"
                              : "text-gray-500 hover:text-gray-900 hover:bg-gray-50")">
                    Usuarios
                </a>

                <a asp-controller="PanelAdmin"
                   asp-action="Aeropuertos"
                   class="px-3 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2
                          @(ViewContext.RouteData.Values["action"]?.ToString() == "Aeropuertos"
                              ? "text-blue-600 bg-blue-50"
                              : "text-gray-500 hover:text-gray-900 hover:bg-gray-50")">
                    Aeropuertos
                </a>

                <a asp-controller="PanelAdmin"
                   asp-action="Rutas"
                   class="px-3 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2
                          @(ViewContext.RouteData.Values["action"]?.ToString() == "Rutas"
                              ? "text-blue-600 bg-blue-50"
                              : "text-gray-500 hover:text-gray-900 hover:bg-gray-50")">
                    Rutas
                </a>
            </nav>
        </div>
    </div>
</div>

<main class="bg-gray-50 min-h-screen">
    @RenderBody()
</main>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}