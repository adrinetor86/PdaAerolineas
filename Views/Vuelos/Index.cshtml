            </div>

        </form>
    </div>
</div>



<script>
    function cambiarPagina(p) {
        document.getElementById('inputNumPag').value = p;
        document.getElementById('formFiltros').submit();
    }

    function resetPage() {
        document.getElementById('inputNumPag').value = 1;
    }

    function sortBy(col, dir) {
        document.getElementById('inputSortCol').value = col;
        document.getElementById('inputSortDir').value = dir;
        resetPage();
        document.getElementById('formFiltros').submit();
    }

    function clearField(name) {
        const el = document.querySelector(`[name="${name}"]`);
        if (el) el.value = '';
        resetPage();
        document.getElementById('formFiltros').submit();
    }

    document.getElementById('checkAll').addEventListener('change', function () {
        document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
    });
</script>


<script>
    const tripulantesPorRol = {
        capitan: [
            @foreach (var t in ViewData["COMANDANTES"] as List<Tripulante> ?? new List<Tripulante>())
            {
                @:{id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@t.Rol"},
            }
        ],
        copiloto: [
            @foreach (var t in ViewData["COPILOTOS"] as List<Tripulante> ?? new List<Tripulante>())
            {
                @:{id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@t.Rol"},
            }
        ],
        tcp: [
            @foreach (var t in ViewData["TCPS"] as List<Tripulante> ?? new List<Tripulante>())
            {
                @:{id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@t.Rol"},
            }
        ]
    };
    let rolActual = null;
    

    function abrirSelector(rol) {
        rolActual = rol;
        const labels = {capitan: 'Capitán', copiloto: 'Primer Oficial', tcp: 'TCP'};
        document.getElementById('selectorLabel').innerText = labels[rol];
        renderizarLista(tripulantesPorRol[rol]);
        document.getElementById('selectorModal').classList.replace('hidden', 'flex');
    }

    function cerrarSelector() {
        document.getElementById('selectorModal').classList.replace('flex', 'hidden');
    }

    function renderizarLista(lista) {
        document.getElementById('selectorLista').innerHTML = lista.map(t => `
            <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-blue-50 cursor-pointer">
                <input type="${rolActual === 'tcp' ? 'checkbox' : 'radio'}" name="selectorOpc" value="${t.id}" data-nombre="${t.nombre}" class="w-4 h-4 accent-blue-600" />
                <div><p class="text-sm font-bold text-gray-800">${t.nombre}</p><p class="text-[10px] text-gray-500 uppercase">${t.rol}</p></div>
            </label>`).join('');
    }

    function aplicarSelector() {
        const sel = [...document.querySelectorAll('input[name="selectorOpc"]:checked')];
        if (!sel.length) {
            cerrarSelector();
            return;
        }
        if (rolActual === 'tcp') {
            const display = document.getElementById('tcp-display');
            document.getElementById('tcp-empty')?.remove();
            sel.forEach(s => {
                if (document.querySelector(`.tag-tcp[data-id="${s.value}"]`)) return;
                const div = document.createElement('div');
                div.className = "tag-tcp inline-flex items-center gap-1.5 bg-blue-600 text-white px-2.5 py-1 rounded-full text-xs font-bold";
                div.setAttribute('data-id', s.value);
                div.innerHTML = `${s.dataset.nombre} <button type="button" onclick="eliminarTcp(${s.value})" class="ml-1 hover:text-red-200">✕</button><input type="hidden" name="idsTcp" value="${s.value}" />`;
                display.appendChild(div);
            });
        } else {
            document.getElementById(`${rolActual}-input`).value = sel[0].value;
            document.getElementById(`${rolActual}-display`).value = sel[0].dataset.nombre;
        }
        sincronizarConCache();
        cerrarSelector();
    }

    function eliminarTcp(id) {
        document.querySelector(`.tag-tcp[data-id="${id}"]`)?.remove();
        if (!document.querySelectorAll('.tag-tcp').length)
            document.getElementById('tcp-display').innerHTML = '<span id="tcp-empty" class="text-xs text-gray-400 italic">No hay TCPs asignados</span>';
        sincronizarConCache();
    }

    function obtenerDatosUI() {
        const c = document.getElementById('gestionVueloContainer');
        if (!c) return null;
        return {
            IdVuelo: parseInt(c.getAttribute('data-idvuelo')),
            IdEstado: parseInt(document.getElementById('inputEstado').value),
            Puerta: document.getElementById('inputPuerta').value,
            PasajerosConfirmados: parseInt(document.getElementById('inputConfirmados').value) || 0,
            PasajerosEmbarcados: parseInt(document.getElementById('inputEmbarcados').value) || 0,
            IdCapitan: parseInt(document.getElementById('capitan-input').value) || 0,
            IdCopiloto: parseInt(document.getElementById('copiloto-input').value) || 0,
            IdsTcp: Array.from(document.querySelectorAll('input[name="idsTcp"]')).map(i => parseInt(i.value))
        };
    }

    async function sincronizarConCache() {
        const s = document.getElementById('statusCache');
        if (!s) return;
        s.innerText = "Sincronizando...";
        try {
            await fetch("/Vuelos/ActualizarBorrador", {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(obtenerDatosUI())
            });
            s.innerText = "Borrador Guardado";
        } catch (e) {
            s.innerText = "Error sync";
        }
    }

    function initModalHandlers() {
        document.querySelectorAll('.cache-input').forEach(i => i.addEventListener('blur', sincronizarConCache));
    }
</script>

<script>
    $(document).ready(function () {


// Abrir modal
        $("#btnOpenModal").on("click", function () {
            $("#modalOverlay")
                .removeClass("hidden")
                .addClass("flex");
        });
// Cerrar modal (botones)
        $(".btnCloseModal").on("click", function () {
            $("#modalOverlay")
                .addClass("hidden")
                .removeClass("flex");
        });

        $("#modalOverlay").on("click", function (e) {
            if ($(e.target).is("#modalOverlay")) {
                $(this)
                    .addClass("hidden")
                    .removeClass("flex");
            }
        });
    });

    $(document).ready(function () {
        $("#btnOpenModal").on("click", () => $("#modalOverlay").removeClass("hidden").addClass("flex"));
        $(".btnCloseModal").on("click", () => $("#modalOverlay").addClass("hidden").removeClass("flex"));
        $("#modalOverlay").on("click", function (e) {
            if ($(e.target).is("#modalOverlay")) $(this).addClass("hidden").removeClass("flex");
        });
        $("#selectAvion").change(function () {
            const avion = $(this).val();
            if (!avion) return;
            fetch("/Vuelos/GetRutasPorAvion", {
                method: "POST",
                headers: {"Content-Type": "application/x-www-form-urlencoded"},
                body: new URLSearchParams({idAvion: avion})
            })
                .then(r => r.ok ? r.json() : r.text().then(t => {
                    throw new Error(t);
                }))
                .then(rutas => {
                    const sel = document.getElementById("selectDestino");
                    sel.innerHTML = '<option disabled selected>Seleccionar destino</option>';
                    if (rutas.length > 0) {
                        document.getElementById("rutaContainer").classList.remove("hidden");
                        document.getElementById("inputOrigen").value = rutas[0].codOrigen;
                        rutas.forEach(r => sel.innerHTML += `<option value="${r.id}">${r.codDestino} (${r.distancia} km)</option>`);
                    }
                });
        });
    });
</script>

