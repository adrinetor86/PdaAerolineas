@model List<VistaVuelo>

@{
    var estados = ViewData["ESTADOS"] as List<EstadoVuelo> ?? new List<EstadoVuelo>();

    var currentBusqueda = Context.Request.Query["busqueda"].ToString();
    var currentEstado = Context.Request.Query["idEstado"].ToString();
    var currentFecha = Context.Request.Query["fechaSalida"].ToString();
    var currentNumFilas = Context.Request.Query["numFilas"].ToString();
    if (string.IsNullOrEmpty(currentNumFilas)) currentNumFilas = "10";

    var currentPage = 1;
    int.TryParse(Context.Request.Query["numPag"], out currentPage);
    if (currentPage < 1) currentPage = 1;

    var totalRegistros = ViewData["TOTAL_REGISTROS"] != null ? (int)ViewData["TOTAL_REGISTROS"] : Model.Count;
    var pageSize = int.Parse(currentNumFilas);
    var totalPaginas = (int)Math.Ceiling((double)totalRegistros / pageSize);
    if (totalPaginas < 1) totalPaginas = 1;
    var inicioRegistro = (currentPage - 1) * pageSize + (Model.Count > 0 ? 1 : 0);
    var finRegistro = inicioRegistro + Model.Count - 1;

    var currentSort = Context.Request.Query["sortCol"].ToString();
    var currentOrder = Context.Request.Query["sortDir"].ToString();
    if (string.IsNullOrEmpty(currentOrder)) currentOrder = "asc";

    string BadgeClass(int? id)
    {
        return id switch
        {
            1 => "bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-200",
            2 => "bg-orange-50 text-orange-700 ring-1 ring-inset ring-orange-200",
            3 => "bg-sky-50 text-sky-700 ring-1 ring-inset ring-sky-200",
            4 => "bg-purple-50 text-purple-700 ring-1 ring-inset ring-purple-200",
            5 => "bg-red-50 text-red-700 ring-1 ring-inset ring-red-200",
            6 => "bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-200",
            7 => "bg-green-50 text-green-700 ring-1 ring-inset ring-green-200",
        };
    }

    string SortTextClass(string col)
    {
        return currentSort == col ? "text-blue-600" : "text-gray-500 hover:text-gray-800";
    }

    string NextDir(string col)
    {
        return currentSort == col && currentOrder == "asc" ? "desc" : "asc";
    }

    string SortArrow(string col)
    {
        if (currentSort != col) return "↑↓";
        return currentOrder == "asc" ? "↑" : "↓";
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

    <div class="flex items-end justify-between mb-6">
        <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">Gestor Vuelos</h2>
            <p class="mt-0.5 text-xs font-mono text-gray-400">
                @totalRegistros vuelos &nbsp;·&nbsp; página @currentPage de @totalPaginas
            </p>
        </div>
        <button id="btnOpenModal"
                class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-blue-700 active:bg-blue-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="3">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Nuevo Vuelo
        </button>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

        <form method="get" asp-controller="Vuelos" asp-action="Index" id="formFiltros">
            <input type="hidden" name="numPag" id="inputNumPag" value="@currentPage"/>
            <input type="hidden" name="sortCol" id="inputSortCol" value="@currentSort"/>
            <input type="hidden" name="sortDir" id="inputSortDir" value="@currentOrder"/>

            <div
                class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 bg-gray-50/70 px-5 py-3">

                <div class="flex flex-wrap items-center gap-2">

                    <a href="@Url.Action("Index", "Vuelos")"
                       class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 hover:border-red-400 hover:text-red-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <path d="M3 6h18"/>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                        </svg>
                        Clear
                    </a>

                    <div class="relative">
                        <select name="idEstado" onchange="resetPage(); this.form.submit()"
                                class="appearance-none cursor-pointer rounded-lg border py-1.5 pl-3 pr-7 text-xs font-semibold outline-none transition-all
                                       @(!string.IsNullOrEmpty(currentEstado)
                                                                                  ? "border-blue-400 bg-blue-50 text-blue-700 ring-1 ring-blue-200"
                                                                                  : "border-gray-300 bg-white text-gray-700 hover:border-gray-400 focus:border-blue-400")">
                            <option value="">Todos los estados</option>
                            @foreach (var es in estados)
                            {
                                <option value="@es.IdEstado"
                                        selected="@(currentEstado == es.IdEstado.ToString() ? "selected" : null)">@es.NombreEstado</option>
                            }
                        </select>
                        <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400"
                             xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </div>

                    <input type="date" name="fechaSalida" value="@currentFecha"
                           onchange="resetPage(); this.form.submit()"
                           class="cursor-pointer rounded-lg border py-1.5 px-3 text-xs font-semibold outline-none transition-all
                                  @(!string.IsNullOrEmpty(currentFecha)
                                                                        ? "border-blue-400 bg-blue-50 text-blue-700 ring-1 ring-blue-200"
                                                                        : "border-gray-300 bg-white text-gray-700 hover:border-gray-400 focus:border-blue-400")"/>

                    @if (!string.IsNullOrEmpty(currentBusqueda))
                    {
                        <span
                            class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200">
                             &ldquo;@currentBusqueda&rdquo;
                            <button type="button" onclick="clearField('busqueda')"
                                    class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(currentEstado))
                    {
                        var eName = estados.FirstOrDefault(e => e.IdEstado.ToString() == currentEstado)?.NombreEstado ?? currentEstado;
                        <span
                            class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200">
                            Estado: @eName
                            <button type="button" onclick="clearField('idEstado')"
                                    class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(currentFecha))
                    {
                        <span
                            class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-bold text-blue-700 ring-1 ring-blue-200">
                             @currentFecha
                            <button type="button" onclick="clearField('fechaSalida')"
                                    class="ml-0.5 opacity-60 hover:opacity-100">✕</button>
                        </span>
                    }
                </div>

                <div class="relative">
                    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"
                         xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" name="busqueda" value="@currentBusqueda"
                           placeholder="Buscar vuelo, ruta, matrícula..."
                           onkeydown="if(event.key==='Enter'){ resetPage(); this.form.submit(); }"
                           class="w-64 rounded-lg border py-1.5 pl-9 pr-4 text-xs font-mono outline-none transition-all focus:w-80
                                  @(!string.IsNullOrEmpty(currentBusqueda)
                                                                        ? "border-blue-400 bg-blue-50 text-blue-700 ring-1 ring-blue-200"
                                                                        : "border-gray-300 bg-white text-gray-700 focus:border-blue-400 focus:ring-1 focus:ring-blue-100")"/>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-gray-200 bg-gray-50/40">
                    <tr>
                        <th class="cursor-pointer select-none px-5 py-3"
                            onclick="sortBy('numero_vuelo','@NextDir("numero_vuelo")')">
                                <span
                                    class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider @SortTextClass("numero_vuelo")">
                                    Vuelo <span
                                        class="font-mono text-[10px] opacity-50">@SortArrow("numero_vuelo")</span>
                                </span>
                        </th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-gray-500">Ruta</th>
                        <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-gray-500">Aeronave</th>
                        <th class="cursor-pointer select-none px-5 py-3"
                            onclick="sortBy('fecha_salida','@NextDir("fecha_salida")')">
                                <span
                                    class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider @SortTextClass("fecha_salida")">
                                    Salida <span
                                        class="font-mono text-[10px] opacity-50">@SortArrow("fecha_salida")</span>
                                </span>
                        </th>
                        <th class="cursor-pointer select-none px-5 py-3"
                            onclick="sortBy('estado_vuelo','@NextDir("estado_vuelo")')">
                                <span
                                    class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider @SortTextClass("estado_vuelo")">
                                    Estado <span
                                        class="font-mono text-[10px] opacity-50">@SortArrow("estado_vuelo")</span>
                                </span>
                        </th>
                        <th class="px-5 py-3 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                            Acciones
                        </th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-5 py-16 text-center">
                                <div class="text-4xl opacity-20">✈</div>
                                <p class="mt-2 text-sm text-gray-400">No se encontraron vuelos con los filtros
                                    aplicados.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var vuelo in Model)
                    {
                        <tr class="group transition-colors hover:bg-gray-50/70">

                            <td class="px-5 py-3.5">
                                <span class="font-mono text-sm font-semibold text-gray-900">@vuelo.NumVuelo</span>
                            </td>
                            <td class="px-5 py-3.5">
                                <div class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-gray-800">
                                    <span>@vuelo.CodOrigen</span>
                                    <svg class="shrink-0 text-gray-300" xmlns="http://www.w3.org/2000/svg" width="11"
                                         height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5">
                                        <path d="M5 12h14M12 5l7 7-7 7"/>
                                    </svg>
                                    <span>@vuelo.CodDestino</span>
                                </div>
                            </td>
                            <td class="px-5 py-3.5">
                                <span class="font-mono text-xs text-gray-500">@vuelo.Matricula</span>
                            </td>
                            <td class="px-5 py-3.5">
                                <span
                                    class="font-mono text-xs text-gray-500">@vuelo.Salida.ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td class="px-5 py-3.5">
                                    <span
                                        class="inline-block rounded-md px-2.5 py-0.5 text-xs font-bold tracking-wide @BadgeClass(vuelo.IdEstado)">
                                        @vuelo.Estado.ToLower()
                                    </span>
                            </td>
                            <td class="px-5 py-3.5">
                                <div
                                    class="flex items-center justify-end opacity-60 transition-opacity group-hover:opacity-100">
                                    <a asp-controller="Vuelos" asp-action="GestionarVuelo"
                                       asp-route-idVuelo="@vuelo.IdVuelo"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-blue-600 text-xs font-bold text-white shadow-sm transition-all hover:bg-blue-700 hover:shadow-md active:scale-95"
                                       title="Gestionar Vuelo">
                                        Gestión
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 12h14"/>
                                            <path d="m12 5 7 7-7 7"/>
                                        </svg>
                                    </a>

                                    @if (vuelo.IdEstado == 3)
                                    {
                                        <a asp-controller="Vuelos" asp-action="Tracking" asp-route-idVuelo="@vuelo.IdVuelo"
                                           class="ml-2 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 text-xs font-bold text-white shadow-sm transition-all hover:bg-emerald-700 hover:shadow-md active:scale-95"
                                           title="Ver en directo">
                                            Directo
                                        </a>
                                    }
                                    else if(vuelo.IdEstado == 7)
                                    {
                                        <a asp-controller="Vuelos" asp-action="Tracking" asp-route-idVuelo="@vuelo.IdVuelo"
                                           class="ml-2 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 text-xs font-bold text-white shadow-sm transition-all hover:bg-emerald-700 hover:shadow-md active:scale-95"
                                           title="Ver en directo">
                                            Detalles Vuelo
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div
                class="flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 bg-gray-50/70 px-5 py-3">

                <p class="font-mono text-xs text-gray-500">
                    Showing <strong class="text-gray-800">@inicioRegistro</strong>
                    to <strong class="text-gray-800">@finRegistro</strong>
                    of <strong class="text-gray-800">@totalRegistros</strong> entries
                </p>

                <div class="flex items-center gap-3">

                    <div class="flex items-center gap-1">

                        <button type="button" onclick="cambiarPagina(1)" @(currentPage <= 1 ? "disabled" : "")
                                class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">
                            «
                        </button>
                        <button type="button" onclick="cambiarPagina(@(currentPage - 1))"
                                @(currentPage <= 1 ? "disabled" : "")
                                class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">
                            ‹
                        </button>

                        @{
                            var rng = 2;
                            var start = Math.Max(1, currentPage - rng);
                            var end = Math.Min(totalPaginas, currentPage + rng);
                        }

                        @if (start > 1)
                        {
                            <button type="button" onclick="cambiarPagina(1)"
                                    class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">
                                1
                            </button>
                            if (start > 2)
                            {
                                <span class="px-1 font-mono text-xs text-gray-400">…</span>
                            }
                        }

                        @for (var p = start; p <= end; p++)
                        {
                            if (p == currentPage)
                            {
                                <button type="button" onclick="cambiarPagina(@p)"
                                        class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-900 bg-gray-900 font-mono text-xs font-bold text-white">@p</button>
                            }
                            else
                            {
                                <button type="button" onclick="cambiarPagina(@p)"
                                        class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@p</button>
                            }
                        }

                        @if (end < totalPaginas)
                        {
                            if (end < totalPaginas - 1)
                            {
                                <span class="px-1 font-mono text-xs text-gray-400">…</span>
                            }

                            <button type="button" onclick="cambiarPagina(@totalPaginas)"
                                    class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-600 transition-all hover:border-blue-400 hover:text-blue-600">@totalPaginas</button>
                        }

                        <button type="button" onclick="cambiarPagina(@(currentPage + 1))"
                                @(currentPage >= totalPaginas ? "disabled" : "")
                                class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">
                            ›
                        </button>
                        <button type="button" onclick="cambiarPagina(@totalPaginas)"
                                @(currentPage >= totalPaginas ? "disabled" : "")
                                class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 bg-white font-mono text-xs text-gray-500 transition-all hover:border-blue-400 hover:text-blue-600 disabled:cursor-not-allowed disabled:opacity-30">
                            »
                        </button>
                    </div>

                    <div class="relative">
                        <select name="numFilas" onchange="resetPage(); this.form.submit()"
                                class="appearance-none cursor-pointer rounded-lg border border-gray-300 bg-white py-1.5 pl-3 pr-7 font-mono text-xs text-gray-700 outline-none transition-all hover:border-gray-400 focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                            <option value="5" selected="@(currentNumFilas == "5" ? "selected" : null)">5</option>
                            <option value="10" selected="@(currentNumFilas == "10" ? "selected" : null)">10</option>
                            <option value="20" selected="@(currentNumFilas == "20" ? "selected" : null)">20</option>
                            <option value="50" selected="@(currentNumFilas == "50" ? "selected" : null)">50</option>
                        </select>
                        <svg class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-gray-400"
                             xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>


@{
    List<Avion> aviones = ViewData["AVIONES"] as List<Avion> ?? new List<Avion>();
    List<string> numeroVuelos = ViewData["NUMEROVUELOS"] as List<string> ?? new List<string>();
}
<div id="modalOverlay"
     class="fixed inset-0 bg-black/40 backdrop-blur-sm hidden items-center justify-center z-50 transition-opacity">

    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl p-8 relative m-4 max-h-[95vh] overflow-y-auto">

        <div class="flex justify-between items-center mb-8 border-b border-gray-100 pb-4">
            <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" class="text-blue-600">
                    <path
                        d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-.9-.5-2.9 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.7l-1.2 3.6c-.2.5.1.9.5 1l6.7 2.1L7.5 16l-3.3-1c-.4-.1-.8.1-1 .5L2 17.5c-.2.4 0 .9.5 1l5.4 1.7L11.5 22c.4.1.8-.1 1-.5l1.5-2.6c.1-.3 0-.8-.5-1l-3.3-1 2.3-2.3 6.6 3.1c.4.1.9-.1 1-.6l.7-1.4c.1-.4 0-.8-.5-1z"/>
                </svg>
                Programar Nuevo Vuelo
            </h2>
            <button
                class="btnCloseModal text-gray-400 hover:text-gray-700 text-2xl transition bg-gray-100 hover:bg-gray-200 rounded-full w-8 h-8 flex items-center justify-center">
                &times;
            </button>
        </div>

        <form method="post" asp-controller="Vuelos" asp-action="Create" class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Nº Vuelo
                        *</label>
                    <select id="selectNumeroVuelo" name="numeroVuelo" required
                            class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition cursor-pointer">
                        <option value="" disabled selected>Seleccionar número de vuelo</option>
                        @foreach (string vuelo in numeroVuelos)
                        {
                            <option value="@vuelo">@vuelo</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Aeronave Asignada
                        *</label>
                    <select id="selectAvion" name="avion" required
                            class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition cursor-pointer">
                        <option value="" disabled selected>Seleccionar matrícula</option>
                        @foreach (Avion avion in aviones)
                        {
                            <option value="@avion.IdAvion">@avion.Matricula</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Fecha y Hora de
                        Salida *</label>
                    <input type="datetime-local" name="FechaSalida" required
                           class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white outline-none transition"/>
                </div>
            </div>

            <div id="rutaContainer" class="hidden mt-6 p-5 bg-blue-50/50 border border-blue-100 rounded-xl">
                <h3 class="text-xs font-bold text-blue-800 uppercase tracking-wider mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"/>
                        <path d="m15 6 6 6-6 6"/>
                    </svg>
                    Plan de Ruta
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-500 uppercase mb-1">Origen (Ubicación actual)</label>
                        <input type="text" id="inputOrigen" readonly
                               class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-gray-100 text-gray-600 font-mono font-bold"/>
                    </div>

