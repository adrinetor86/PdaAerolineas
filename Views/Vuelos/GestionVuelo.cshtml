@model VistaVuelo

@{
// Datos de soporte desde el Controller
var comandantes = ViewData["COMANDANTES"] as List<Tripulante> ?? new();
var copilotos   = ViewData["COPILOTOS"]   as List<Tripulante> ?? new();
var tcps        = ViewData["TCPS"]        as List<Tripulante> ?? new();
var idVuelo = Model.IdVuelo;
// Datos ya asignados al vuelo
TripulanteAsignado tripulacionActual = ViewData["TRIPULACION"] as TripulanteAsignado ?? new TripulanteAsignado { Tcps = new() };

var pasos = new[] { "Programado", "Embarcando", "En Vuelo", "Aterrizado", "Cancelado", "Completado" };
var estadoActual = Model.IdEstado; // 1 a 6
}

<div id="modalGestionar" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 max-h-[90vh] overflow-y-auto">

        <div class="flex items-start justify-between px-6 pt-6 pb-4">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Gestionar Vuelo @Model.NumVuelo</h2>
                <p class="text-sm text-gray-500 mt-0.5">Control de estados y tripulación</p>
            </div>
            <a href="/Vuelos" class="text-gray-400 hover:text-gray-600 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </a>
        </div>

        <div class="px-6 pb-6">
            <div class="flex items-center">
                @for (int i = 0; i < pasos.Length; i++)
                {
                var pasoNum = i + 1;
                var esActivo = pasoNum == estadoActual;
                var esCompletado = pasoNum < estadoActual;

                <div class="flex flex-col items-center @(i < pasos.Length - 1 ? "flex-1" : "")">
                    <div class="flex items-center w-full">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all
                                @(esActivo ? "bg-blue-600 border-blue-600 text-white shadow-lg shadow-blue-200" :
                        esCompletado ? "bg-blue-100 border-blue-300 text-blue-600" : "bg-white border-gray-200 text-gray-400")">
                            @if (esCompletado) { <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg> }
                            else { @pasoNum }
                        </div>
                        @if (i < pasos.Length - 1) {
                        <div class="flex-1 h-0.5 mx-1 @(pasoNum < estadoActual ? "bg-blue-300" : "bg-gray-200")"></div>
                        }
                    </div>
                    <span class="text-[10px] mt-2 font-medium @(esActivo ? "text-blue-600" : "text-gray-400")">@pasos[i]</span>
                </div>
                }
            </div>
        </div>

        <form method="post" id="formGestionar">
            
            <input type="hidden" name="idVuelo" value="@Model.IdVuelo"/>
            <input type="hidden" name="numerovuelo" value="@Model.NumVuelo"/>
            <input type="hidden" id="inputEstado" name="estado" value="@Model.IdEstado"/>
            <input type="hidden" name="aerolinea" value="@Model.IdAerolinea"/>
            <input type="hidden" name="ruta" value="@Model.IdRuta"/>
            <input type="hidden" name="avion" value="@Model.IdAvion"/>
            <input type="hidden" name="capacidad" value="@Model.Capacidad"/>
            <input type="hidden" name="salida" value="@Model.Salida" />
            <input type="hidden" name="llegada" value="@Model.Llegada" />
            <div class="px-6 space-y-6">

                <div id="alertaValidacion" class="hidden bg-amber-50 border border-amber-200 rounded-xl p-3 flex items-start gap-3">
                    <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                    <p class="text-xs text-amber-800 font-medium" id="mensajeValidacion">Completa los campos obligatorios.</p>
                </div>

                <div class="step-content @(estadoActual > 1 ? "opacity-60 pointer-events-none" : "")">
                    <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-4 bg-blue-500 rounded-full"></span>
                        Asignación de Tripulación (Paso 1)
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-500 mb-1">Capitán *</label>
                            <div class="relative">
                                <input id="capitan-display-input" type="text" readonly placeholder="Seleccionar..."
                                       value="@(tripulacionActual.Comandante?.Nombre) @(tripulacionActual.Comandante?.Apellido)".trim()
                                       onclick="abrirSelector('capitan')"
                                       class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm cursor-pointer hover:border-blue-400 bg-white"/>
                                <input type="hidden" name="idCapitan" id="capitan-input" value="@tripulacionActual.Comandante?.IdTripulante"/>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-500 mb-1">Primer Oficial *</label>
                            <div class="relative">
                                <input id="copiloto-display-input" type="text" readonly placeholder="Seleccionar..."
                                       value="@(tripulacionActual.Oficial?.Nombre) @(tripulacionActual.Oficial?.Apellido)".trim()
                                       onclick="abrirSelector('copiloto')"
                                       class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm cursor-pointer hover:border-emerald-400 bg-white"/>
                                <input type="hidden" name="idCopiloto" id="copiloto-input" value="@tripulacionActual.Oficial?.IdTripulante"/>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="text-xs font-semibold text-gray-500">Tripulantes de Cabina (TCP)</label>
                            <button type="button" onclick="abrirSelector('tcp')" class="text-xs font-bold text-blue-600 hover:underline">+ Añadir</button>
                        </div>
                        <div id="tcp-display" class="min-h-[45px] border border-dashed border-gray-200 rounded-xl p-2.5 flex flex-wrap gap-2">
                            @if (tripulacionActual.Tcps != null && tripulacionActual.Tcps.Any())
                            {
                                foreach (var t in tripulacionActual.Tcps)
                                {
                                    <div class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-full" data-id="@t.IdTripulante">
                                        @t.Nombre @t.Apellido
                                        <button type="button" onclick="quitarTcp(@t.IdTripulante)" class="text-blue-400 hover:text-blue-700">✕</button>
                                        <input type="hidden" name="idsTcp" value="@t.IdTripulante"/>
                                    </div>
                                }
                            }
                            else
                            {
                                <span id="tcp-empty" class="text-xs text-gray-400 italic">No hay TCPs asignados</span>
                            }
                        </div>
                        <div id="tcp-inputs"></div>
                    </div>
                </div>

                
                <div id="seccion-tripulacion" class="step-content @(estadoActual > 1 ? "opacity-60 pointer-events-none" : "")">
                </div>

                <div id="step-2" class="step-content @(estadoActual < 2 ? "hidden" : "") @(estadoActual > 2 ? "opacity-60 pointer-events-none" : "")">
                    <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-4 bg-emerald-500 rounded-full"></span>
                        Control de Embarque (Paso 2)
                    </h3>
                </div>
                
                <div class="step-content @(estadoActual < 2 ? "hidden" : "") @(estadoActual > 2 ? "opacity-60 pointer-events-none" : "")">
                    <h3 class="text-sm font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <span class="w-1 h-4 bg-emerald-500 rounded-full"></span>
                        Control de Embarque (Paso 2)
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Confirmados</label>
                            <input type="number" name="confirmados" value="@Model.PasajerosConfirmados" class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm"/>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Embarcados</label>
                            <input type="number" name="embarcados" value="@Model.PasajerosEmbarcados" class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm"/>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Puerta Embarque</label>
                            <input type="text" name="puerta" value="@Model.Puerta" class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm"/>
                        </div>
                    </div>
                </div>

                @if (estadoActual >= 3)
                {
                    <div class="p-4 bg-blue-50 rounded-xl border border-blue-100 flex items-center gap-3">
                        <div class="animate-pulse w-2 h-2 bg-blue-500 rounded-full"></div>
                        <p class="text-xs text-blue-700 font-medium">El vuelo se encuentra actualmente en tránsito.</p>
                    </div>
                }

            </div>

            <div class="px-6 py-5 mt-8 border-t border-gray-100 flex items-center justify-between bg-gray-50 rounded-b-2xl">
                <a href="/Vuelos" class="text-sm font-semibold text-gray-400 hover:text-gray-600 transition-colors">Cancelar</a>

                <div class="flex gap-3">
                    <button type="button" onclick="enviarDatosVuelo()"
                            class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-all">
                        Solo Guardar
                    </button>

                    @if (estadoActual < 6)
                    {
                        <button type="button" onclick="avanzarEstado()"
                                class="bg-blue-600 text-white px-6 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all">
                            Confirmar @pasos[estadoActual] →
                        </button>
                    }
                </div>

            </div>
        </form>
    </div>
</div>

<div id="selectorModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/30">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b">
            <h3 class="font-bold text-gray-800">Seleccionar <span id="selectorLabel" class="text-blue-600"></span></h3>
            <button onclick="cerrarSelector()" class="text-gray-400 hover:text-gray-600">✕</button>
        </div>
        <div class="p-4">
            <input type="text" id="selectorBusqueda" placeholder="Buscar..." oninput="filtrarSelector(this.value)"
                   class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none mb-3" />
            <div id="selectorLista" class="max-h-60 overflow-y-auto space-y-1"></div>
        </div>
        <div class="px-5 py-3 border-t bg-gray-50 flex justify-end gap-2">
            <button onclick="cerrarSelector()" class="text-sm font-bold text-gray-500 px-4 py-2">Cancelar</button>
            <button onclick="aplicarSelector()" class="bg-blue-600 text-white text-sm font-bold px-5 py-2 rounded-lg">Aplicar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. DATA DESDE EL SERVIDOR (Configurada correctamente para Razor)
    const tripulantesPorRol = {
        capitan: [
            @foreach (var t in comandantes) {
                @:{ id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@Html.Raw(t.Rol)" },
            }
        ],
        copiloto: [
            @foreach (var t in copilotos) {
                @:{ id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@Html.Raw(t.Rol)" },
            }
        ],
        tcp: [
            @foreach (var t in tcps) {
                @:{ id: @t.IdTripulante, nombre: "@Html.Raw(t.Nombre) @Html.Raw(t.Apellido)", rol: "@Html.Raw(t.Rol)" },
            }
        ]
    };

    const labels = { capitan: 'Capitán', copiloto: 'Primer Oficial', tcp: 'TCP' };
    let rolActual = null;

    // 2. FUNCIONES DEL SELECTOR
    function abrirSelector(rol) {
        rolActual = rol;
        document.getElementById('selectorLabel').textContent = labels[rol];
        document.getElementById('selectorBusqueda').value = '';
        renderizarLista(tripulantesPorRol[rol]);
        
        const modal = document.getElementById('selectorModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function cerrarSelector() {
        const modal = document.getElementById('selectorModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function renderizarLista(lista) {
        const contenedor = document.getElementById('selectorLista');
        const esTcp = rolActual === 'tcp';
        
        if (!lista || lista.length === 0) {
            contenedor.innerHTML = '<p class="text-center text-sm text-gray-400 py-4 italic">Sin resultados</p>';
            return;
        }
        
        contenedor.innerHTML = lista.map(t => `
            <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-blue-50 cursor-pointer transition-colors">
                <input type="${esTcp ? 'checkbox' : 'radio'}" name="selectorOpc" value="${t.id}" data-nombre="${t.nombre}" class="w-4 h-4 text-blue-600" />
                <div class="text-sm">
                    <p class="font-bold text-gray-800">${t.nombre}</p>
                    <p class="text-[10px] text-gray-500 uppercase">${t.rol}</p>
                </div>
            </label>
        `).join('');
    }

    function aplicarSelector() {
        const seleccionados = [...document.querySelectorAll('input[name="selectorOpc"]:checked')];
        if (seleccionados.length === 0) { cerrarSelector(); return; }

        if (rolActual === 'capitan') {
            document.getElementById('capitan-input').value = seleccionados[0].value;
            document.getElementById('capitan-display-input').value = seleccionados[0].dataset.nombre;
        } else if (rolActual === 'copiloto') {
            document.getElementById('copiloto-input').value = seleccionados[0].value;
            document.getElementById('copiloto-display-input').value = seleccionados[0].dataset.nombre;
        } else if (rolActual === 'tcp') {
            const display = document.getElementById('tcp-display');
            const emptyHint = document.getElementById('tcp-empty');
            
            if (emptyHint) emptyHint.style.display = 'none';

            seleccionados.forEach(s => {
                if (document.querySelector(`div[data-tcp-id="${s.value}"]`)) return;
                
                const tag = document.createElement('div');
                tag.setAttribute('data-tcp-id', s.value);
                tag.className = 'inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-full';
                tag.innerHTML = `
                    ${s.dataset.nombre} 
                    <button type="button" onclick="quitarTcp(${s.value})" class="text-blue-400 hover:text-blue-700">✕</button>
                    <input type="hidden" name="idsTcp" value="${s.value}" />
                `;
                display.appendChild(tag);
            });
        }
        cerrarSelector();
    }

    function quitarTcp(id) {
        const elemento = document.querySelector(`div[data-tcp-id="${id}"]`);
        if (elemento) elemento.remove();
        
        const display = document.getElementById('tcp-display');
        const remaining = display.querySelectorAll('div[data-tcp-id]');
        if (remaining.length === 0) {
            document.getElementById('tcp-empty').style.display = 'block';
        }
    }

    function filtrarSelector(val) {
        const q = val.toLowerCase();
        const filtrados = tripulantesPorRol[rolActual].filter(t => t.nombre.toLowerCase().includes(q));
        renderizarLista(filtrados);
    }

    document.getElementById('formGestionar').addEventListener('submit', function(e) {
        e.preventDefault(); // Evita que la página se recargue
        enviarDatosVuelo();
    });
    

    function actualizarStepperVisual(pasoActivo) {
        const pasosNombres = ["", "Programado", "Embarcando", "En Vuelo", "Aterrizado", "Cancelado", "Completado"];
        const contenedoresPasos = document.querySelectorAll('#modalGestionar .flex-col.items-center');

        contenedoresPasos.forEach((div, index) => {
            const num = index + 1;
            const circulo = div.querySelector('.rounded-full');
            const texto = div.querySelector('span');
            const linea = div.querySelector('.flex-1.h-0\\.5'); // Escapamos el punto del selector

            if (num === pasoActivo) {
                circulo.className = "flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all bg-blue-600 border-blue-600 text-white shadow-lg shadow-blue-200";
                texto.className = "text-[10px] mt-2 font-medium text-blue-600";
                circulo.innerHTML = num;
            } else if (num < pasoActivo) {
                circulo.className = "flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all bg-blue-100 border-blue-300 text-blue-600";
                texto.className = "text-[10px] mt-2 font-medium text-blue-400";
                circulo.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>';
                if (linea) linea.className = "flex-1 h-0.5 mx-1 bg-blue-300";
            }
        });

        // Actualizar el texto del botón de avance
        const btnAvance = document.querySelector('button[onclick="avanzarEstado()"]');
        if (btnAvance && pasoActivo < 6) {
            btnAvance.textContent = `Confirmar ${pasosNombres[pasoActivo + 1]} →`;
        } else if (btnAvance) {
            btnAvance.style.display = 'none'; // Ocultar si ya está completado
        }
}

    // Función para mostrar/ocultar los bloques de inputs según el paso
    function actualizarSeccionesFormulario(pasoActivo) {
        // 1. Bloquear Tripulación si ya avanzamos del paso 1
        const sec1 = document.getElementById('seccion-tripulacion');
        if (sec1 && pasoActivo > 1) {
            sec1.classList.add('opacity-60', 'pointer-events-none');
        }

        // 2. Manejar Sección de Embarque (Paso 2)
        const sec2 = document.getElementById('step-2');
        if (sec2) {
            if (pasoActivo >= 2) {
                sec2.classList.remove('hidden');
                // Solo hacemos scroll si acaba de aparecer (si no estaba visible antes)
                if (pasoActivo === 2) {
                    sec2.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }

            // Si ya pasamos al paso 3, bloqueamos la edición del paso 2
            if (pasoActivo > 2) {
                sec2.classList.add('opacity-60', 'pointer-events-none');
            }
        }
}
    async function enviarDatosVuelo() {

        const form = document.getElementById('formGestionar');

        // ⚠️ Crear el FormData DESPUÉS de que el estado esté actualizado
        const formData = new FormData(form);

        try {
            const response = await fetch("/Vuelos/GestionVuelo", {
                method: 'POST',
                body: formData
            });

            const text = await response.text();
            console.log("Respuesta cruda del servidor:", text);

            const result = await response.json();

            console.log("Respuesta servidor:", result);

            if (result.success) {

                const estadoReal = Number(result.nuevoEstado);

                if (isNaN(estadoReal)) {
                    console.error("nuevoEstado viene inválido:", result.nuevoEstado);
                    return;
                }

                document.getElementById('inputEstado').value = estadoReal;

                actualizarStepperVisual(estadoReal);
                actualizarSeccionesFormulario(estadoReal);

                console.log("✅ Estado actualizado correctamente:", estadoReal);
            }
        } catch (error) {
            console.error("Error en Fetch:", error);
        }
}

    // Actualiza tu función avanzarEstado para que use la nueva lógica
    function avanzarEstado() {
        const input = document.getElementById('inputEstado');
        const estadoActual = parseInt(input.value);

        if (estadoActual === 1) {
            const cap = document.getElementById('capitan-input').value;
            const cop = document.getElementById('copiloto-input').value;

            if (!cap || !cop) {
                document.getElementById('alertaValidacion').classList.remove('hidden');
                return;
            }
        }

        if (confirm("¿Confirmar y avanzar al siguiente estado?")) {
            input.value = estadoActual + 1;
            enviarDatosVuelo();
        }
}
    
    
</script>
}